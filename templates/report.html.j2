}
.content{padding:24px 30px 30px}
.panel{
  position:relative;
  border:1px solid #d6e0ed;
  border-radius:16px;
  padding:20px 20px 18px;
  background:#fff;
  margin:0 0 16px;
}
.panel::before{
  content:"";
  position:absolute;
  left:0;
  top:0;
  bottom:0;
  width:4px;
  border-top-left-radius:15px;
  border-bottom-left-radius:15px;
  background:#b2c7de;
}
.panel[data-tone="summary"]::before{background:linear-gradient(180deg,#0d3b66 0%,#3877b3 100%)}
.panel[data-tone="insights"]::before{background:linear-gradient(180deg,#1a6f4f 0%,#38a169 100%)}
.panel[data-tone="figures"]::before{background:linear-gradient(180deg,#6a4ea1 0%,#8b73bc 100%)}
.panel[data-tone="quotes"]::before{background:linear-gradient(180deg,#915019 0%,#d18a44 100%)}
