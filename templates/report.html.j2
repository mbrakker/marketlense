}
.quote-card blockquote{
  position:relative;
  margin:0;
}
.quote-card blockquote::before{
  content:"\201C";
  position:absolute;
  left:-4px;
  top:-17px;
  font-size:3.2rem;
  line-height:1;
  color:#d9b38b;
}
.quote-card blockquote p{
  margin:0 0 12px;
  padding-left:24px;
  font-size:1.07rem;
  line-height:1.55;
}
.quote-byline{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:6px;
  font-size:.85rem;
}
.quote-byline .quote-author{
  color:#4a2b15;
  font-weight:700;
}
.quote-citation{
  display:inline-flex;
  align-items:center;
  gap:4px;
  border:1px solid #e7c69f;
  border-radius:999px;
  padding:3px 8px;
  background:#fff7eb;
  color:#7c4a1e;
  font-family:"Avenir Next","Segoe UI",Tahoma,sans-serif;
}
.figure-carousel{
  display:grid;
  gap:11px;
}
.carousel-shell{
  position:relative;
  border:1px solid #d6dff0;
  border-radius:14px;
  background:#f9fbff;
  overflow:hidden;
}
.carousel-slides{
  position:relative;
}
.carousel-slide{
  margin:0;
  display:none;
}
.carousel-slide.is-active{
  display:block;
}
.carousel-slide img{
  width:100%;
  height:auto;
  max-height:540px;
  object-fit:contain;
  background:#f5f8fd;
  display:block;
}
.carousel-caption{
  padding:8px 11px 10px;
  color:#4f6078;
  border-top:1px solid #d8e3f0;
  font-size:.9rem;
}
.carousel-btn{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  width:38px;
  height:38px;
  border:1px solid #b6c8df;
  border-radius:50%;
  background:rgba(255,255,255,.94);
  color:#0d3b66;
  font-size:1.2rem;
  line-height:1;
  cursor:pointer;
  z-index:3;
}
.carousel-btn:hover{background:#fff}
.carousel-btn[disabled]{opacity:.45;cursor:default}
.carousel-btn.prev{left:12px}
.carousel-btn.next{right:12px}
.carousel-toolbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}
.carousel-count{
  font-size:.84rem;
  color:#4f6078;
  font-family:"Avenir Next","Segoe UI",Tahoma,sans-serif;
}
.lightbox-open{
  border:1px solid #c2d3e8;
  border-radius:999px;
  background:#fff;
  color:#0d3b66;
  font-family:"Avenir Next","Segoe UI",Tahoma,sans-serif;
  font-size:.82rem;
  padding:5px 11px;
  cursor:pointer;
}
.carousel-thumbs{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding-bottom:3px;
}
.carousel-thumb{
  border:1px solid #bfd0e6;
  border-radius:8px;
  padding:2px;
  background:#fff;
  cursor:pointer;
}
.carousel-thumb img{
  display:block;
  width:110px;
  height:68px;
  object-fit:cover;
  border-radius:6px;
}
.carousel-thumb.is-active{
  border-color:#0d3b66;
  box-shadow:0 0 0 2px rgba(13,59,102,.18);
}
.prose-block{
  display:grid;
  gap:11px;
}
.prose-block .prose-paragraph{
  margin:0;
  max-width:100%;
}
.lightbox{
  position:fixed;
  inset:0;
  z-index:120;
  background:rgba(7,15,26,.9);
  display:grid;
  grid-template-rows:auto 1fr;
  padding:14px;
}
.lightbox[hidden]{display:none}
.lightbox-top{
  display:flex;
  justify-content:flex-end;
  margin-bottom:8px;
}
.lightbox-close{
  border:1px solid rgba(255,255,255,.32);
  border-radius:999px;
  background:rgba(255,255,255,.1);
  color:#fff;
  padding:5px 12px;
  font-size:.84rem;
  cursor:pointer;
}
.lightbox figure{
  margin:0;
  display:grid;
  place-items:center;
  gap:10px;
}
.lightbox img{
  max-width:min(95vw,1400px);
  max-height:78vh;
  width:auto;
  height:auto;
}
.lightbox figcaption{
  color:#d8e2f1;
  text-align:center;
  max-width:90ch;
}
.panel[data-reveal]{
  opacity:0;
  transform:translateY(18px);
}
.panel.is-visible{
  opacity:1;
  transform:none;
  transition:opacity .45s ease, transform .45s ease;
}
@media (prefers-reduced-motion:reduce){
  *{
    animation:none!important;
    transition:none!important;
    scroll-behavior:auto!important;
  }
  .panel[data-reveal]{
    opacity:1;
    transform:none;
  }
}
@media (max-width:800px){
  .page-shell{padding:0 12px}
  .content,.section-nav,.footer{padding-left:16px;padding-right:16px}
  .hero-split{
    grid-template-columns:1fr;
    gap:12px;
    padding:20px 16px 18px;
  }
  .hero-card img{
    max-height:260px;
  }
  .section-nav{
    top:0;
    padding:8px 10px;
  }
  .content{
    padding:18px 16px 22px;
  }
  .panel{
    padding:16px 14px 14px;
  }
  .carousel-btn{
    width:34px;
    height:34px;
  }
  .carousel-thumb img{
    width:84px;
    height:56px;
  }
  h1{font-size:1.58rem}
}
@media print{
  body{background:#fff}
  .page-shell{max-width:none;margin:0;padding:0}
  .report{border:none;box-shadow:none;border-radius:0}
  .section-nav,.reading-progress,.lightbox{display:none}
  .panel{break-inside:avoid}
}
</style>
</head>
<body>
  <div class="page-shell">
    <article class="report">
      <header class="hero">
        <div class="hero-split">
          <div class="hero-copy">
            <p class="eyebrow">Market Lense report digest</p>
            <h1>{{ report_title }}</h1>
            <p class="hero-subtitle">
              <span class="hero-subtitle-line"><span class="hero-subtitle-label">Publisher:</span> {% if publisher %}{{ publisher }}{% else %}Unknown publisher{% endif %}</span>
              <span class="hero-subtitle-line"><span class="hero-subtitle-label">Time Period:</span> {% if report_year %}{{ report_year }}{% else %}Not specified{% endif %}</span>
              <span class="hero-subtitle-line"><span class="hero-subtitle-label">Geography:</span> {% if region %}{{ region }}{% else %}Not specified{% endif %}</span>
            </p>
            <ul class="hero-meta">
              {% if has_insights %}<li>{{ insights_ns.count }} insight{% if insights_ns.count != 1 %}s{% endif %}</li>{% endif %}
              {% if has_quotes %}<li>{{ quotes_ns.count }} quote{% if quotes_ns.count != 1 %}s{% endif %}</li>{% endif %}
              {% if has_topics %}<li>{{ topics_list|length }} topic{% if topics_list|length != 1 %}s{% endif %}</li>{% endif %}
              {% if canonical_url %}<li>Source linked</li>{% endif %}
            </ul>
          </div>
          <div class="hero-media">
            {% set hero_image = preview_png if preview_png else (primary_figure if primary_figure else "") %}
            {% if hero_image %}
            <div class="preview">
              <figure class="hero-card">
                <img src="{{ hero_image }}"
                  srcset="{{ hero_image }} 1x, {{ hero_image }} 2x"
                  sizes="(max-width: 800px) 100vw, 38vw"
                  alt="Report preview visual for {{ report_title }}"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  width="{{ preview_width }}"
                  height="{{ preview_height }}">
                <figcaption>Preview panel for the source report.</figcaption>
              </figure>
            </div>
            {% endif %}
          </div>
        </div>
      </header>

      <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>
      <nav class="section-nav" aria-label="Digest sections">
        <div class="nav-scroll">
          <ul class="nav-list">
            <li><a href="#section-summary" data-section-link>TL;DR</a></li>
            {% if has_topics %}<li><a href="#section-topics" data-section-link>Covered topics</a></li>{% endif %}
            {% if exec_summary %}<li><a href="#section-executive" data-section-link>Executive summary</a></li>{% endif %}
            <li><a href="#section-insights" data-section-link>Key data insights</a></li>
            {% if has_primary_figure %}<li><a href="#section-figures" data-section-link>Figures</a></li>{% endif %}
            <li><a href="#section-quotes" data-section-link>Key quotes</a></li>
            {% if has_metadata %}<li><a href="#section-metadata" data-section-link>Report metadata</a></li>{% endif %}
            {% if has_expert_comment %}<li><a href="#section-expert" data-section-link>Expert comment</a></li>{% endif %}
            {% if has_linkedin_post %}<li><a href="#section-linkedin" data-section-link>LinkedIn post</a></li>{% endif %}
          </ul>
        </div>
      </nav>

      <main class="content" id="digest-content">
        {% if not_available %}
        <section class="panel notice" id="section-notice" data-reveal aria-label="Source status">
          Content not available from text{% if fallback_reason %}: {{ fallback_reason }}{% endif %}
        </section>
        {% endif %}

        {% if has_metadata %}
        <section class="panel" id="section-metadata" data-reveal data-section aria-label="Report metadata">
          <h2>Report metadata</h2>
          <div class="meta-stack">
            {% if categories_list and categories_list|length > 0 %}
            <article class="meta-row">
              <span class="meta-label">Categories</span>
              <ul class="chip-list horizontal-strip">
                {% for category in categories_list %}
                  {% set category_value = category|string|trim %}
                  {% if category_value %}
                  <li><span class="chip">{{ format_chip_label(category_value) }}</span></li>
                  {% endif %}
                {% endfor %}
              </ul>
            </article>
            {% endif %}
            {% if tags_list and tags_list|length > 0 %}
            <article class="meta-row">
              <span class="meta-label">Tags</span>
              <ul class="chip-list horizontal-strip">
                {% for tag in tags_list %}
                  {% set tag_value = tag|string|trim %}
                  {% if tag_value %}
                  <li><span class="chip">{{ format_chip_label(tag_value) }}</span></li>
                  {% endif %}
                {% endfor %}
              </ul>
            </article>
            {% endif %}
          </div>
        </section>
        {% endif %}

        <section class="panel" id="section-summary" data-reveal data-section data-tone="summary" aria-label="TL;DR">
          <h2>TL;DR</h2>
          {% if tldr_text %}
            <p class="summary-copy">{{ tldr_text }}</p>
          {% else %}
            <p class="muted">Not available from text.</p>
          {% endif %}
        </section>

        {% if has_topics or not_available %}
        <section class="panel" id="section-topics" data-reveal data-section aria-label="Covered topics">
          <h2>Covered topics</h2>
          {% if has_topics %}
          <ul class="chip-list">
            {% for topic in topics_list %}
              {% set topic_value = topic|string|trim %}
              {% if topic_value %}
              <li><span class="chip">{{ format_chip_label(topic_value) }}</span></li>
              {% endif %}
            {% endfor %}
          </ul>
          {% else %}
          <p class="muted">Not available from text.</p>
          {% endif %}
        </section>
        {% endif %}

        {% if exec_summary %}
        <section class="panel" id="section-executive" data-reveal data-section data-tone="summary" aria-label="Executive summary">
          <h2>Executive summary</h2>
          <p class="summary-copy">{{ exec_summary }}</p>
          {% if has_claim_map %}
          <ul class="claim-list">
            {% for claim in claim_map %}
              {% set claim_text = claim.claim if claim.claim is defined else "" %}
              {% set claim_text = claim_text|string|trim %}
              {% set claim_evidence = claim.evidence if claim.evidence is defined else "" %}
              {% set claim_evidence = claim_evidence|string|trim %}
              {% if claim_text %}
              <li><strong>{{ claim_text }}</strong>{% if claim_evidence %}: {{ claim_evidence }}{% endif %}</li>
              {% endif %}
            {% endfor %}
          </ul>
          {% endif %}
        </section>
        {% endif %}

        <section class="panel" id="section-insights" data-reveal data-section data-tone="insights" aria-label="Key data insights">
          <h2>Key data insights</h2>
          {% if has_insights %}
          <ol class="insight-grid">
            {% for insight in insights_list %}
              {% if insight.text is defined %}
                {% set insight_text = insight.text|string|trim %}
              {% else %}
                {% set insight_text = insight|string|trim %}
              {% endif %}
              {% if insight_text %}
              <li class="insight-card">
                <div class="insight-head">
                  <span class="insight-index">{{ loop.index }}</span>
                  <p class="insight-text">{{ insight_text }}</p>
                </div>
                {% if insight.metric is defined and insight.metric %}
                  {% set metric_value = insight.metric.value if insight.metric.value is defined else "" %}
                  {% set metric_value = metric_value|string|trim %}
                  {% set metric_unit = insight.metric.unit if insight.metric.unit is defined else "" %}
                  {% set metric_unit = metric_unit|string|trim %}
                  {% set metric_timeframe = insight.metric.timeframe if insight.metric.timeframe is defined else "" %}
                  {% set metric_timeframe = metric_timeframe|string|trim %}
                  {% set metric_text = (metric_value ~ " " ~ metric_unit ~ " " ~ metric_timeframe)|replace("  ", " ")|trim %}
                  {% set metric_source = insight.source if insight.source is defined else (insight.citation if insight.citation is defined else "") %}
                  {% set metric_source = metric_source|string|trim %}
                  {% if metric_text %}
                  <div>Key metric: {{ metric_text }}</div>
                  {% endif %}
                  {% if metric_source %}
                  <div class="badge-row">
                    <span class="badge">Source: {{ metric_source }}</span>
                  </div>
                  {% endif %}
                {% endif %}
              </li>
              {% endif %}
            {% endfor %}
          </ol>
          {% else %}
          <p class="muted">Not available from text.</p>
          {% endif %}
        </section>

        {% if has_primary_figure %}
        <section class="panel" id="section-figures" data-reveal data-section data-tone="figures" aria-label="Figure carousel">
          <h2>Figures</h2>
          {% set slide_count = namespace(total=0) %}
          {% if has_primary_figure %}{% set slide_count.total = slide_count.total + 1 %}{% endif %}
          {% if figure_gallery and figure_gallery|length > 1 %}
            {% for fig in figure_gallery %}
              {% set figure_path = fig|string|trim %}
              {% if figure_path and figure_path != primary_figure %}
                {% set slide_count.total = slide_count.total + 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}

          <div class="figure-carousel" data-carousel>
            <div class="carousel-shell">
              <button type="button" class="carousel-btn prev" aria-label="Previous figure" data-carousel-prev>&lsaquo;</button>
              <div class="carousel-slides" tabindex="0">
                {% set slide_ns = namespace(index=0) %}
                {% if has_primary_figure %}
                {% set slide_ns.index = slide_ns.index + 1 %}
                <figure class="carousel-slide{% if slide_ns.index == 1 %} is-active{% endif %}" data-carousel-slide="{{ slide_ns.index }}">
                  <img src="{{ primary_figure }}"
                    srcset="{{ primary_figure }} 1x, {{ primary_figure }} 2x"
                    sizes="(max-width: 800px) 100vw, 980px"
                    alt="Selected figure from {{ report_title }}"
                    loading="lazy"
                    decoding="async"
                    width="{{ figure_width }}"
                    height="{{ figure_height }}">
                  <figcaption class="carousel-caption">{% if figure_caption %}{{ figure_caption }}{% else %}Representative figure from the source report.{% endif %}</figcaption>
                </figure>
                {% endif %}
                {% if figure_gallery and figure_gallery|length > 1 %}
                  {% for fig in figure_gallery %}
                    {% set figure_path = fig|string|trim %}
                    {% if figure_path and figure_path != primary_figure %}
                    {% set slide_ns.index = slide_ns.index + 1 %}
                    <figure class="carousel-slide{% if slide_ns.index == 1 %} is-active{% endif %}" data-carousel-slide="{{ slide_ns.index }}">
                      <img src="{{ figure_path }}"
                        srcset="{{ figure_path }} 1x, {{ figure_path }} 2x"
                        sizes="(max-width: 800px) 100vw, 980px"
                        alt="Additional figure {{ slide_ns.index }} from {{ report_title }}"
                        loading="lazy"
                        decoding="async"
                        width="{{ figure_width }}"
                        height="{{ figure_height }}">
                      <figcaption class="carousel-caption">Additional figure {{ slide_ns.index }}</figcaption>
                    </figure>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </div>
              <button type="button" class="carousel-btn next" aria-label="Next figure" data-carousel-next>&rsaquo;</button>
            </div>
            <div class="carousel-toolbar">
              <span class="carousel-count" data-carousel-count>1 / {{ slide_count.total }}</span>
              <button type="button" class="lightbox-open" data-lightbox-open>Open fullscreen</button>
            </div>
            {% if slide_count.total > 1 %}
            <div class="carousel-thumbs" role="tablist" aria-label="Figure thumbnails">
              {% set thumb_ns = namespace(index=0) %}
              {% if has_primary_figure %}
              {% set thumb_ns.index = thumb_ns.index + 1 %}
              <button type="button" class="carousel-thumb{% if thumb_ns.index == 1 %} is-active{% endif %}" data-carousel-thumb="{{ thumb_ns.index }}" aria-label="Open figure {{ thumb_ns.index }}">
                <img src="{{ primary_figure }}" alt="Figure thumbnail {{ thumb_ns.index }}" loading="lazy" decoding="async" width="{{ thumb_width }}" height="{{ thumb_height }}">
              </button>
              {% endif %}
              {% if figure_gallery and figure_gallery|length > 1 %}
                {% for fig in figure_gallery %}
                  {% set figure_path = fig|string|trim %}
                  {% if figure_path and figure_path != primary_figure %}
                  {% set thumb_ns.index = thumb_ns.index + 1 %}
                  <button type="button" class="carousel-thumb{% if thumb_ns.index == 1 %} is-active{% endif %}" data-carousel-thumb="{{ thumb_ns.index }}" aria-label="Open figure {{ thumb_ns.index }}">
                    <img src="{{ figure_path }}" alt="Figure thumbnail {{ thumb_ns.index }}" loading="lazy" decoding="async" width="{{ thumb_width }}" height="{{ thumb_height }}">
                  </button>
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
            {% endif %}
          </div>
        </section>
        {% endif %}

        <section class="panel" id="section-quotes" data-reveal data-section data-tone="quotes" aria-label="Key quotes">
          <h2>Key quotes</h2>
          {% if has_quotes %}
          <ul class="quote-grid">
            {% for quote in quotes_list %}
              {% if quote.text is defined %}
                {% set quote_text = quote.text|string|trim %}
              {% else %}
                {% set quote_text = quote|string|trim %}
              {% endif %}
              {% if quote_text %}
                {% set quote_author = quote.speaker if quote.speaker is defined and quote.speaker else (quote.author if quote.author is defined else "Unknown") %}
                {% set quote_author = quote_author|string|trim %}
                {% set quote_citation = quote.citation if quote.citation is defined else "" %}
                {% set quote_citation = quote_citation|string|trim %}
                <li>
                  <figure class="quote-card">
                    <blockquote><p>"{{ quote_text }}"</p></blockquote>
                    <figcaption class="quote-byline">
                      <span class="quote-author">{{ quote_author }}</span>
                      {% if quote_citation %}<span class="quote-citation">{{ quote_citation }}</span>{% endif %}
                    </figcaption>
                  </figure>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
          {% else %}
          <p class="muted">Not available from text.</p>
          {% endif %}
        </section>

        {% if has_expert_comment %}
        <section class="panel" id="section-expert" data-reveal data-section aria-label="Expert comment">
          <h2>Expert comment (generated)</h2>
          <div class="prose-block" data-chunk-prose>{{ expert_comment }}</div>
        </section>
        {% endif %}

        {% if has_linkedin_post %}
        <section class="panel" id="section-linkedin" data-reveal data-section aria-label="LinkedIn post">
          <h2>LinkedIn post</h2>
          <div class="prose-block" data-chunk-prose>{{ linkedin_post }}</div>
        </section>
        {% endif %}

        {% if has_commentary %}
        <section class="panel" id="section-commentary" data-reveal data-section aria-label="Commentary">
          <h2>Commentary</h2>
          <div class="prose-block" data-chunk-prose>{{ commentary }}</div>
        </section>
        {% endif %}

        {% if canonical_url or source_url %}
        <section class="panel" id="section-resources" data-reveal data-section aria-label="Related resources">
          <h2>Related resources</h2>
          <ul class="resource-list">
            {% if canonical_url %}<li><a href="{{ canonical_url }}" rel="noopener" target="_blank">Canonical/source URL</a></li>{% endif %}
            {% if source_url and source_url != canonical_url %}<li><a href="{{ source_url }}" rel="noopener" target="_blank">Original source link</a></li>{% endif %}
            <li><a href="#section-summary">Back to TL;DR</a></li>
            <li><a href="#section-insights">Jump to key insights</a></li>
          </ul>
        </section>
        {% endif %}
      </main>

      <div class="lightbox" id="figure-lightbox" hidden aria-hidden="true">
        <div class="lightbox-top">
          <button type="button" class="lightbox-close" data-lightbox-close>Close</button>
        </div>
        <figure>
          <img src="" alt="" id="lightbox-image" width="{{ figure_width }}" height="{{ figure_height }}">
          <figcaption id="lightbox-caption"></figcaption>
        </figure>
      </div>

      <footer class="footer">
        Generated by Market Lense. File ID: <code>{{ file_id }}</code>.
      </footer>
    </article>
  </div>
  <script>
  (function () {
    var progressBar = document.getElementById("reading-progress-bar");
    var navLinks = Array.prototype.slice.call(document.querySelectorAll("[data-section-link]"));
    var sections = Array.prototype.slice.call(document.querySelectorAll("[data-section]"));
    var revealPanels = Array.prototype.slice.call(document.querySelectorAll("[data-reveal]"));
    var lightbox = document.getElementById("figure-lightbox");
    var lightboxImage = document.getElementById("lightbox-image");
    var lightboxCaption = document.getElementById("lightbox-caption");
    var lightboxClose = document.querySelector("[data-lightbox-close]");

    var updateProgress = function () {
      if (!progressBar) {
        return;
      }
      var top = window.scrollY || window.pageYOffset || 0;
      var total = Math.max((document.documentElement.scrollHeight || 0) - window.innerHeight, 1);
      var pct = Math.max(0, Math.min(100, (top / total) * 100));
      progressBar.style.width = pct + "%";
    };

    var activateLink = function (id) {
      navLinks.forEach(function (link) {
        var active = link.getAttribute("href") === "#" + id;
        link.classList.toggle("is-active", active);
      });
    };

    var openLightbox = function (slide) {
      if (!slide || !lightbox || !lightboxImage || !lightboxCaption) {
        return;
      }
      var img = slide.querySelector("img");
      var caption = slide.querySelector("figcaption");
      if (!img) {
        return;
      }
      lightboxImage.src = img.currentSrc || img.src || "";
      lightboxImage.alt = img.alt || "Figure";
      lightboxCaption.textContent = caption ? caption.textContent : "";
      lightbox.hidden = false;
      lightbox.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    var closeLightbox = function () {
      if (!lightbox) {
        return;
      }
      lightbox.hidden = true;
      lightbox.setAttribute("aria-hidden", "true");
      if (lightboxImage) {
        lightboxImage.src = "";
      }
      document.body.style.overflow = "";
    };

    if (lightboxClose) {
      lightboxClose.addEventListener("click", closeLightbox);
    }
    if (lightbox) {
      lightbox.addEventListener("click", function (event) {
        if (event.target === lightbox) {
          closeLightbox();
        }
      });
    }

    var chunkTextBlock = function (element) {
      var text = (element.textContent || "").trim();
      if (!text || text.length < 320) {
        return;
      }
      var parts = [];
      var lines = text.split(/\n+/).map(function (line) { return line.trim(); }).filter(Boolean);
      if (lines.length > 1) {
        parts = lines;
      } else {
        var sentences = text.match(/[^.!?]+[.!?]*/g) || [text];
        var bucket = "";
        sentences.forEach(function (sentence) {
          if ((bucket + " " + sentence).trim().length > 260 && bucket) {
            parts.push(bucket.trim());
            bucket = sentence;
          } else {
            bucket = (bucket ? bucket + " " : "") + sentence;
          }
        });
        if (bucket.trim()) {
          parts.push(bucket.trim());
        }
      }
      if (parts.length < 2) {
        return;
      }
      element.innerHTML = "";
      parts.forEach(function (part) {
        var paragraph = document.createElement("p");
        paragraph.className = "prose-paragraph";
        paragraph.textContent = part;
        element.appendChild(paragraph);
      });
    };

    document.querySelectorAll("[data-chunk-prose]").forEach(chunkTextBlock);

    if ("IntersectionObserver" in window) {
      var sectionObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            activateLink(entry.target.id);
          }
        });
      }, { rootMargin: "-35% 0px -45% 0px", threshold: 0.01 });
      sections.forEach(function (section) { sectionObserver.observe(section); });

      var revealObserver = new IntersectionObserver(function (entries, observer) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: "0px 0px -10% 0px", threshold: 0.1 });
      revealPanels.forEach(function (panel) { revealObserver.observe(panel); });
    } else {
      revealPanels.forEach(function (panel) { panel.classList.add("is-visible"); });
    }

    var initCarousel = function (carousel) {
      var slides = Array.prototype.slice.call(carousel.querySelectorAll("[data-carousel-slide]"));
      var thumbs = Array.prototype.slice.call(carousel.querySelectorAll("[data-carousel-thumb]"));
      var prev = carousel.querySelector("[data-carousel-prev]");
      var next = carousel.querySelector("[data-carousel-next]");
      var count = carousel.querySelector("[data-carousel-count]");
      var open = carousel.querySelector("[data-lightbox-open]");
      var stage = carousel.querySelector(".carousel-slides");
      var index = 0;

      var setSlide = function (target) {
        if (!slides.length) {
          return;
        }
        index = ((target % slides.length) + slides.length) % slides.length;
        slides.forEach(function (slide, i) {
          slide.classList.toggle("is-active", i === index);
        });
        thumbs.forEach(function (thumb, i) {
          thumb.classList.toggle("is-active", i === index);
        });
        if (count) {
          count.textContent = (index + 1) + " / " + slides.length;
        }
        if (prev) {
          prev.disabled = slides.length <= 1;
        }
        if (next) {
          next.disabled = slides.length <= 1;
        }
      };

      if (prev) {
        prev.addEventListener("click", function () { setSlide(index - 1); });
      }
      if (next) {
        next.addEventListener("click", function () { setSlide(index + 1); });
      }
      thumbs.forEach(function (thumb, i) {
        thumb.addEventListener("click", function () { setSlide(i); });
      });
      slides.forEach(function (slide, i) {
        slide.addEventListener("click", function () { setSlide(i); openLightbox(slides[index]); });
      });
      if (open) {
        open.addEventListener("click", function () { openLightbox(slides[index]); });
      }
      if (stage) {
        stage.addEventListener("keydown", function (event) {
          if (event.key === "ArrowLeft") {
            event.preventDefault();
            setSlide(index - 1);
          } else if (event.key === "ArrowRight") {
            event.preventDefault();
            setSlide(index + 1);
          }
        });
        var touchStartX = null;
        stage.addEventListener("touchstart", function (event) {
          touchStartX = event.changedTouches[0].clientX;
        }, { passive: true });
        stage.addEventListener("touchend", function (event) {
          if (touchStartX === null) {
            return;
          }
          var delta = event.changedTouches[0].clientX - touchStartX;
          if (Math.abs(delta) > 45) {
            setSlide(index + (delta < 0 ? 1 : -1));
          }
          touchStartX = null;
        }, { passive: true });
      }

      setSlide(0);
    };

    document.querySelectorAll("[data-carousel]").forEach(initCarousel);

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape") {
        closeLightbox();
      }
    });
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();
    if (sections.length > 0) {
      activateLink(sections[0].id);
    }
  })();
  </script>
</body>
</html>
