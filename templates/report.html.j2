<!doctype html>
{% import "_report_macros.j2" as macros %}
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ view.seo.title }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ view.seo.description }}">
<meta name="robots" content="{{ view.seo.robots }}">
<meta name="theme-color" content="#082b52">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23082b52'/%3E%3Ccircle cx='43' cy='43' r='7' fill='%23005cc8'/%3E%3Cpath d='M13 38h30v4H13z' fill='white'/%3E%3C/svg%3E">
<meta property="og:site_name" content="MarketBearing">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ view.seo.title }}">
<meta property="og:description" content="{{ view.seo.description }}">
{% if view.canonical_url %}<meta property="og:url" content="{{ view.canonical_url }}">{% endif %}
{% if view.seo.primary_image %}<meta property="og:image" content="{{ view.seo.primary_image }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ view.seo.title }}">
<meta name="twitter:description" content="{{ view.seo.description }}">
{% if view.seo.primary_image %}<meta name="twitter:image" content="{{ view.seo.primary_image }}">{% endif %}
{% if view.canonical_url %}<link rel="canonical" href="{{ view.canonical_url }}">{% endif %}
{% if view.seo.primary_image %}<link rel="preload" as="image" href="{{ view.seo.primary_image }}" fetchpriority="high">{% endif %}
<script type="application/ld+json">{{ json_ld|tojson }}</script>
<style>
{% include "report.css.j2" %}
</style>
</head>
<body class="ml-ingest-report-content">
<article class="report-document">
  <section class="hero" aria-labelledby="report-title">
    <div class="hero-inner">
      <div class="hero-intro">
        <p class="eyebrow">Executive intelligence brief</p>
        <h1 id="report-title">{{ view.report_title }}</h1>
        <p class="hero-thesis">
          {% if view.summary.tldr_text %}
          {{ view.summary.tldr_text }}
          {% elif view.statuses.summary.status == "abstained" %}
          TLDR omitted because evidence support was too weak.
          {% else %}
          {{ view.summary.executive_summary }}
          {% endif %}
        </p>
      </div>

      <div class="hero-meta-block">
        {% if view.report_identity_items %}
        <ul class="meta-row" aria-label="Report metadata">
          {% for item in view.report_identity_items %}
          <li class="meta-pill">{{ item }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>

      <aside class="signal-panel" aria-label="Core report signal and score">
        <div class="signal-top">
          <p class="eyebrow">Core signal</p>
          <h2>{{ view.core_signal.heading }}</h2>
          <p>{{ view.core_signal.body }}</p>
        </div>
        <div class="signal-stat-grid">
          <div class="signal-stat"><strong>{{ view.insights|length }}</strong><span>source-backed findings</span></div>
          <div class="signal-stat"><strong>{{ view.quotes|length }}</strong><span>verbatim report signals</span></div>
          <div class="signal-stat"><strong>{{ view.topics|length if view.topics else view.snapshot.tags|length }}</strong><span>taxonomy themes</span></div>
        </div>
        <div class="hero-score" aria-label="Downloaded report quality score">
          <div class="hero-score-main">
            <span class="score-eyebrow">Report quality</span>
            <strong>{{ view.quality_score.overall_label }}</strong>
            <span>{% if view.quality_score.available %}{{ view.quality_score.value_band|capitalize }} source value{% else %}Source quality score unavailable for this report.{% endif %}</span>
            <span class="score-pin" aria-hidden="true"></span>
          </div>
          <div class="score-dimensions" role="list" aria-label="Score dimensions">
            {% for component in view.quality_score.components %}
            <span class="score-dimension" role="listitem" data-dimension="{{ component.dimension }}">
              <span>{{ component.label }}</span>
              <b>{{ component.score_label }}</b>
              <i aria-hidden="true" style="--fill:{{ component.fill }}%"></i>
            </span>
            {% endfor %}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <div class="page-grid" id="content">
    <aside class="toc" aria-label="Report sections">
      <p class="toc-title">Navigate</p>
      <nav>
        <a href="#overview" data-section-link>Overview</a>
        <a href="#findings" data-section-link>Findings</a>
      {% if view.display.has_figures %}<a href="#candidates" data-section-link>Visual evidence</a>{% endif %}
        <a href="#signals" data-section-link>Signals</a>
        <a href="#evidence" data-section-link>Evidence</a>
        {% if view.display.has_appendix %}<a href="#expert" data-section-link>Expert view</a>{% endif %}
        {% if view.display.has_metadata or view.display.has_topics %}<a href="#taxonomy" data-section-link>Taxonomy</a>{% endif %}
        <a href="#source" data-section-link>Source</a>
      </nav>
    </aside>

    <div class="content">
      {% if view.not_available %}
      <section class="section notice" id="notice" data-section aria-label="Source status">
        Content not available from text{% if view.fallback_reason %}: {{ view.fallback_reason }}{% endif %}
      </section>
      {% endif %}

      <section class="section" id="overview" data-section>
        <div class="section-head">
          <p class="section-kicker">01. Overview</p>
          <div>
            <h2>{{ view.report_title }}</h2>
            <p class="section-lede">Executive summary of the source report, shaped for fast review and downstream decision-making.</p>
          </div>
        </div>
        <article class="summary-panel summary-panel-executive" aria-label="Report executive summary">
          <div class="summary-body">
            <h3>Executive summary</h3>
            {% if view.summary.executive_summary %}
            <p>{{ view.summary.executive_summary }}</p>
            {% elif view.statuses.summary.status == "abstained" %}
            <p class="muted">Executive summary omitted because evidence support was too weak ({{ view.statuses.summary.reason if view.statuses.summary.reason else "insufficient_evidence_support" }}).</p>
            {% else %}
            <p class="muted">Not available from text.</p>
            {% endif %}
          </div>
        </article>

        {% if view.summary.claim_map %}
        <div class="claim-strip" aria-label="Executive claim evidence map">
          {% for claim in view.summary.claim_map[:3] %}
          <article>
            <span>{{ "%02d"|format(loop.index) }}</span>
            <p><strong>{{ claim.claim }}</strong>{% if claim.citation_line %}<small>{{ claim.citation_line }}</small>{% endif %}</p>
          </article>
          {% endfor %}
        </div>
        {% endif %}

        {% if view.display.has_public_intelligence %}
        <section class="report-intelligence-panel" id="report-intelligence" aria-label="Report intelligence modules">
          {% if view.public_intelligence.topics_covered %}
          <article class="intelligence-module intelligence-module-topics">
            <div class="advisory-panel-head">
              <span class="badge">Coverage map</span>
              <h3>Topics covered</h3>
            </div>
            <div class="intelligence-topic-list">
              {% for topic in view.public_intelligence.topics_covered %}
              <article>
                <h4>{{ topic.topic }}</h4>
                <p>{{ topic.summary }}</p>
                {% if topic.subtopics %}<small>{{ topic.subtopics|join(" · ") }}</small>{% endif %}
                {% if topic.source_label %}<small>{{ topic.source_label }}</small>{% endif %}
              </article>
              {% endfor %}
            </div>
          </article>
          {% endif %}

          {% if view.public_intelligence.key_figures %}
          <article class="intelligence-module">
            <div class="advisory-panel-head">
              <span class="badge green">Quantified</span>
              <h3>Key figures</h3>
            </div>
            <dl class="key-figure-list">
              {% for figure in view.public_intelligence.key_figures %}
              <div>
                <dt>{{ figure.value }}</dt>
                <dd>{{ figure.label }}{% if figure.context %}<small>{{ figure.context }}</small>{% endif %}{% if figure.confidence_label %}<small>{{ figure.confidence_label }}</small>{% endif %}</dd>
              </div>
              {% endfor %}
            </dl>
          </article>
          {% endif %}

          {% if view.public_intelligence.chart_insight_cards %}
          <article class="intelligence-module intelligence-module-charts">
            <div class="advisory-panel-head">
              <span class="badge green">Visual read</span>
              <h3>Chart insight cards</h3>
            </div>
            <div class="chart-insight-grid">
              {% for card in view.public_intelligence.chart_insight_cards %}
              <article>
                <span class="badge{% if card.status_label == 'Chart-backed' %} green{% endif %}">{{ card.status_label }}</span>
                <h4>{{ card.title }}</h4>
                {% if card.insight %}<p>{{ card.insight }}</p>{% endif %}
                {% if card.so_what or card.now_what %}
                <dl class="insight-implications compact">
                  {% if card.so_what %}<div><dt>So what</dt><dd>{{ card.so_what }}</dd></div>{% endif %}
                  {% if card.now_what %}<div><dt>Now what</dt><dd>{{ card.now_what }}</dd></div>{% endif %}
                </dl>
                {% endif %}
                {% if card.limitation %}<small>{{ card.limitation }}</small>{% endif %}
              </article>
              {% endfor %}
            </div>
          </article>
          {% endif %}
        </section>
        {% endif %}

        {% if view.display.has_advisory %}
        <div class="advisory-suite" aria-label="Decision advisory and source-backed claim support">
          {% if view.advisory.decision.available %}
          <article class="advisory-panel advisory-panel-brief">
            <div class="advisory-panel-head">
              <span class="badge green">Source-backed</span>
              <h3>Decision brief</h3>
            </div>
            {% if view.advisory.decision.strategic_context %}
            <p>{{ view.advisory.decision.strategic_context }}</p>
            {% endif %}
            {% if view.advisory.decision.decision_implications %}
            <ul class="advisory-list">
              {% for item in view.advisory.decision.decision_implications %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
            {% endif %}
            {% if view.advisory.decision.confidence_note %}
            <small>{{ view.advisory.decision.confidence_note }}</small>
            {% endif %}
          </article>
          {% endif %}

          {% if view.advisory.metric_spine %}
          <section class="advisory-panel">
            <div class="advisory-panel-head">
              <span class="badge">Quantified proof</span>
              <h3>Metric spine</h3>
            </div>
            <div class="metric-spine-grid">
              {% for metric in view.advisory.metric_spine %}
              <article class="metric-spine-card">
                <strong>{{ metric.value }}</strong>
                <span>{{ metric.label }}</span>
                {% if metric.context %}<small>{{ metric.context }}</small>{% endif %}
                {% if metric.confidence_label %}<small>{{ metric.confidence_label }}</small>{% endif %}
              </article>
              {% endfor %}
            </div>
          </section>
          {% endif %}

          {% if view.advisory.recommendations or view.advisory.decision.priority_moves %}
          <section class="advisory-panel">
            <div class="advisory-panel-head">
              <span class="badge green">Actionable</span>
              <h3>Priority moves</h3>
            </div>
            <ul class="advisory-list">
              {% for item in view.advisory.recommendations %}
              <li>{{ item.text }}</li>
              {% endfor %}
              {% for item in view.advisory.decision.priority_moves %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </section>
          {% endif %}

          {% if view.advisory.risks or view.advisory.decision.watchouts %}
          <section class="advisory-panel">
            <div class="advisory-panel-head">
              <span class="badge">Caveat-aware</span>
              <h3>Watchouts</h3>
            </div>
            <ul class="advisory-list">
              {% for item in view.advisory.risks %}
              <li>{{ item.text }}</li>
              {% endfor %}
              {% for item in view.advisory.decision.watchouts %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </section>
          {% endif %}

          {% if view.advisory.claim_support %}
          <section class="advisory-panel">
            <div class="advisory-panel-head">
              <span class="badge green">Traceable</span>
              <h3>Claim support</h3>
            </div>
            <div class="claim-support-list">
              {% for claim in view.advisory.claim_support %}
              <article>
                <p>{{ claim.claim }}</p>
                <small>{{ claim.support_label }}</small>
              </article>
              {% endfor %}
            </div>
          </section>
          {% endif %}
        </div>
        {% endif %}
      </section>

      <section class="section" id="findings" data-section>
        <div class="section-head">
          <p class="section-kicker">02. Findings</p>
          <div>
            <h2>What leaders should take from the report.</h2>
            <p class="section-lede">The most decision-relevant points are presented as short, source-backed findings so the report can be evaluated quickly.</p>
          </div>
        </div>
        {% if view.display.has_insights %}
        <div class="finding-list">
          {% for insight in view.insights %}
          <article class="finding-card">
            <div class="card-meta"><span class="badge green">Report-supported</span>{% if insight.citation_line %}<span class="badge">{{ insight.citation_line }}</span>{% endif %}</div>
            <h3>{{ insight.text }}</h3>
            {% if insight.so_what or insight.now_what %}
            <dl class="insight-implications">
              {% if insight.so_what %}
              <div><dt>So what</dt><dd>{{ insight.so_what }}</dd></div>
              {% endif %}
              {% if insight.now_what %}
              <div><dt>Now what</dt><dd>{{ insight.now_what }}</dd></div>
              {% endif %}
            </dl>
            {% endif %}
          </article>
          {% endfor %}
        </div>
        {% elif view.statuses.insights.status == "abstained" %}
        <p class="muted">Key findings omitted because evidence support was too weak ({{ view.statuses.insights.reason if view.statuses.insights.reason else "insufficient_evidence_support" }}).</p>
        {% else %}
        <p class="muted">Not available from text.</p>
        {% endif %}
      </section>

      {% if view.display.has_figures %}
      <section class="section visual-candidate-section" id="candidates" data-section>
        <div class="section-head">
          <p class="section-kicker">03. Visual evidence</p>
          <div>
            <h2>Charts and tables worth reviewing first.</h2>
            <p class="section-lede">These visuals give the fastest route into the report's quantitative evidence, frameworks and supporting exhibits.</p>
          </div>
        </div>
        <div class="candidate-toolbar">
          <p class="section-lede">Showing {{ view.figures.visual_candidates|length }} high-value visual{{ "s" if view.figures.visual_candidates|length != 1 else "" }} from this report.</p>
          {% if view.figures.visual_candidates|length > 1 %}
          <div class="carousel-controls" aria-label="Visual candidate carousel controls">
            <button class="carousel-button" type="button" data-carousel-prev aria-label="Previous visual candidate">&lsaquo;</button>
            <button class="carousel-button" type="button" data-carousel-next aria-label="Next visual candidate">&rsaquo;</button>
          </div>
          {% endif %}
        </div>
        <div class="visual-candidate-carousel" data-visual-candidate-carousel tabindex="0" aria-label="Top extracted visual candidates">
          {% for slide in view.figures.visual_candidates %}
          <article class="visual-candidate-slide">
            <figure class="visual-candidate-card">
              {{ macros.responsive_image(slide, loading=("eager" if loop.index == 1 else "lazy"), fetchpriority=("high" if loop.index == 1 else "auto")) }}
              <figcaption class="visual-candidate-copy">
                <span class="candidate-score">{{ slide.kind|capitalize if slide.kind else "Figure" }}{% if slide.page >= 0 %} &middot; page {{ slide.page + 1 }}{% endif %}</span>
                <h3>{{ slide.caption }}</h3>
              </figcaption>
            </figure>
          </article>
          {% endfor %}
        </div>
      </section>
      {% endif %}

      <section class="section" id="signals" data-section>
        <div class="section-head">
          <p class="section-kicker">{% if view.display.has_figures %}04{% else %}03{% endif %}. Signals</p>
          <div>
            <h2>Signals to watch after reading this report.</h2>
            <p class="section-lede">Use these themes as a concise market read from this source: where attention is shifting, what may matter next, and which assumptions deserve follow-up.</p>
          </div>
        </div>
        {% if view.signal_cards %}
        <div class="tag-grid">
          {% for card in view.signal_cards %}
          <article class="tag-card">
            <h3>{{ macros.format_chip_label(card.title, tag_acronym_map) }}</h3>
            <p>{{ card.summary }}</p>
          </article>
          {% endfor %}
        </div>
        {% else %}
        <p class="muted">No report signals were extracted.</p>
        {% endif %}
      </section>

      <section class="section" id="evidence" data-section>
        <div class="section-head">
          <p class="section-kicker">{% if view.display.has_figures %}05{% else %}04{% endif %}. Evidence</p>
          <div>
            <h2>Source language behind the read.</h2>
            <p class="section-lede">Selected verbatim excerpts preserve the report's own wording so readers can check tone, emphasis and evidence quality.</p>
          </div>
        </div>
        {% if view.display.has_quotes %}
        <div class="quote-board">
          {% set lead_quote = view.quotes[0] %}
          <figure class="quote-feature">
            <blockquote>&ldquo;{{ lead_quote.text }}&rdquo;</blockquote>
            <figcaption>{{ lead_quote.author }}{% if lead_quote.citation_line %}<br>{{ lead_quote.citation_line }}{% endif %}</figcaption>
          </figure>
          <div class="quote-stack">
            {% for quote in view.quotes[1:6] %}
            <figure class="quote-card">
              <blockquote>&ldquo;{{ quote.text }}&rdquo;</blockquote>
              <figcaption>{{ quote.author }}{% if quote.citation_line %}<br>{{ quote.citation_line }}{% endif %}</figcaption>
            </figure>
            {% endfor %}
          </div>
        </div>
        {% elif view.statuses.quotes.status == "abstained" %}
        <p class="muted">Key quotes omitted because evidence support was too weak ({{ view.statuses.quotes.reason if view.statuses.quotes.reason else "insufficient_evidence_support" }}).</p>
        {% else %}
        <p class="muted">Not available from text.</p>
        {% endif %}
      </section>

      {% if view.expert_comment or view.linkedin_post or view.statuses.expert.status == "abstained" or view.statuses.linkedin.status == "abstained" %}
      <section class="section" id="expert" data-section>
        <div class="section-head">
          <p class="section-kicker">{% if view.display.has_figures %}06{% else %}05{% endif %}. Expert view</p>
          <div>
            <h2>MarketBearing expert view.</h2>
            <p class="section-lede">Our team's perspective translates the report into practical implications for business, brand and digital leaders.</p>
          </div>
        </div>
        <article class="expert-panel">
          <aside class="expert-aside">
            <div class="expert-avatar" aria-hidden="true">MB</div>
            <div>
              <h3>Expert perspective from our intelligence team</h3>
              <p>Focused on trust, operating model and commercial execution.</p>
            </div>
          </aside>
          <div class="expert-copy">
            {% if view.expert_comment %}
            <div data-chunk-prose>{{ view.expert_comment }}</div>
            {% elif view.statuses.expert.status == "abstained" %}
            <p class="muted">Expert comment omitted because evidence support was too weak ({{ view.statuses.expert.reason if view.statuses.expert.reason else "insufficient_evidence_support" }}).</p>
            {% endif %}
          </div>
        </article>
        {% if view.linkedin_post %}
        <details class="linkedin-details">
          <summary class="linkedin-summary">
            <span class="linkedin-label"><span class="linkedin-logo" aria-hidden="true">in</span> LinkedIn-ready post</span>
          </summary>
          <div class="linkedin-post">{{ view.linkedin_post }}</div>
        </details>
        {% elif view.statuses.linkedin.status == "abstained" %}
        <p class="muted">LinkedIn post omitted because evidence support was too weak ({{ view.statuses.linkedin.reason if view.statuses.linkedin.reason else "insufficient_evidence_support" }}).</p>
        {% endif %}
      </section>
      {% endif %}

      {% if view.display.has_metadata or view.display.has_topics %}
      <section class="section" id="taxonomy" data-section>
        <div class="section-head">
          <p class="section-kicker">{% if view.display.has_figures %}07{% else %}06{% endif %}. Taxonomy</p>
          <div>
            <h2>Where this report fits in the knowledge base.</h2>
            <p class="section-lede">Categories, tags and chapters make the report easier to compare, retrieve and connect with adjacent market intelligence.</p>
          </div>
        </div>
        <div class="topic-map">
          {% if view.snapshot.categories %}
          <details open>
            <summary>Categories</summary>
            <div class="topic-body">{{ macros.chip_list(view.snapshot.categories, tag_acronym_map) }}</div>
          </details>
          {% endif %}
          {% if view.snapshot.tags %}
          <details>
            <summary>Tags</summary>
            <div class="topic-body">{{ macros.chip_list(view.snapshot.tags, tag_acronym_map) }}</div>
          </details>
          {% endif %}
          {% if view.chapters %}
          <details>
            <summary>Ordered chapters</summary>
            <div class="topic-body">
              {% for chapter in view.chapters %}
              <p><strong>{{ chapter.order }}. {{ chapter.title }}</strong>{% if chapter.pages %}<br><span class="muted">Pages: {{ chapter.pages|join(", ") }}</span>{% endif %}{% if chapter.summary %}<br>{{ chapter.summary }}{% endif %}</p>
              {% endfor %}
            </div>
          </details>
          {% endif %}
        </div>
      </section>
      {% endif %}

      <section class="section" id="source" data-section>
        <div class="section-head">
          <p class="section-kicker">{% if view.display.has_figures %}08{% else %}07{% endif %}. Source</p>
          <div>
            <h2>Read the source and check provenance.</h2>
            <p class="section-lede">Use this area to open the original material and understand how MarketBearing turned the report into a structured briefing.</p>
          </div>
        </div>
        <div class="source-layout">
          {% if view.hero_image %}
          <figure class="source-frame">
            {{ macros.responsive_image(view.hero_image, loading="lazy") }}
            <figcaption>{{ view.hero_image.caption }}</figcaption>
          </figure>
          {% endif %}
          <div>
            <div class="download-card">
              <h3>Full report</h3>
              <p>Open the source material used for this MarketBearing analysis.</p>
              <div class="download-actions">
                {% if view.source_download_href %}<a class="download-link" href="{{ view.source_download_href }}" download>Download full report</a>{% endif %}
                {% if view.source_url %}<a class="download-link secondary" href="{{ view.source_url }}" rel="noopener" target="_blank">Open original source</a>{% endif %}
              </div>
              {% if not view.source_download_href and not view.source_url %}
              <p class="muted">Source URL: Not available</p>
              {% endif %}
            </div>
            <div class="method-list">
              {% for card in view.editorial_cards if card["items"] %}
              <div class="method-item">
                <span class="method-num">{{ "%02d"|format(loop.index) }}</span>
                <p><strong>{{ card["label"] }}.</strong> {{ card["items"][:2]|join(" ") }}</p>
              </div>
              {% endfor %}
              <div class="method-item">
                <span class="method-num">{{ "%02d"|format((view.editorial_cards|selectattr("items")|list|length) + 1) }}</span>
                <p><strong>Rendering.</strong> Generated from report artifacts, normalized metadata, persisted figures and source scoring where available.</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</article>

<script>
(function () {
  var progress = document.getElementById("progress-bar");
  var links = Array.prototype.slice.call(document.querySelectorAll("[data-section-link]"));
  var sections = Array.prototype.slice.call(document.querySelectorAll("[data-section]"));
  var candidateCarousel = document.querySelector("[data-visual-candidate-carousel]");

  function scrollCandidates(direction) {
    if (!candidateCarousel) return;
    var firstSlide = candidateCarousel.querySelector(".visual-candidate-slide");
    var distance = firstSlide ? firstSlide.getBoundingClientRect().width + 16 : candidateCarousel.clientWidth * 0.86;
    candidateCarousel.scrollBy({ left: direction * distance, behavior: "smooth" });
  }

  var prev = document.querySelector("[data-carousel-prev]");
  var next = document.querySelector("[data-carousel-next]");
  if (prev) prev.addEventListener("click", function () { scrollCandidates(-1); });
  if (next) next.addEventListener("click", function () { scrollCandidates(1); });

  function chunkTextBlock(element) {
    var text = (element.textContent || "").trim();
    if (!text || text.length < 320) return;
    var parts = [];
    var lines = text.split(/\n+/).map(function (line) { return line.trim(); }).filter(Boolean);
    if (lines.length > 1) {
      parts = lines;
    } else {
      var sentences = text.match(/[^.!?]+[.!?]*/g) || [text];
      var bucket = "";
      sentences.forEach(function (sentence) {
        if ((bucket + " " + sentence).trim().length > 260 && bucket) {
          parts.push(bucket.trim());
          bucket = sentence;
        } else {
          bucket = (bucket ? bucket + " " : "") + sentence;
        }
      });
      if (bucket.trim()) parts.push(bucket.trim());
    }
    if (parts.length < 2) return;
    element.innerHTML = "";
    parts.forEach(function (part) {
      var paragraph = document.createElement("p");
      paragraph.className = "prose-paragraph";
      paragraph.textContent = part;
      element.appendChild(paragraph);
    });
  }
  document.querySelectorAll("[data-chunk-prose]").forEach(chunkTextBlock);

  function updateProgress() {
    if (!progress) return;
    var max = document.documentElement.scrollHeight - window.innerHeight;
    var pct = max > 0 ? (window.scrollY / max) * 100 : 0;
    progress.style.inlineSize = Math.min(100, Math.max(0, pct)) + "%";
  }
  window.addEventListener("scroll", updateProgress, { passive: true });
  updateProgress();

  if ("IntersectionObserver" in window) {
    var observer = new IntersectionObserver(function (entries) {
      var visible = entries
        .filter(function (entry) { return entry.isIntersecting; })
        .sort(function (a, b) { return b.intersectionRatio - a.intersectionRatio; })[0];
      if (!visible) return;
      links.forEach(function (link) {
        link.classList.toggle("is-active", link.getAttribute("href") === "#" + visible.target.id);
      });
    }, { rootMargin: "-20% 0px -60% 0px", threshold: [0.08, 0.18, 0.32] });
    sections.forEach(function (section) { observer.observe(section); });
  }
})();
</script>
</body>
</html>
