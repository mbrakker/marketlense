<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="drive-file-id" content="{{ file_id }}">
<style>
body{font-family:system-ui,Arial,sans-serif;max-width:760px;margin:40px auto;padding:0 20px;line-height:1.55}
h1,h2{line-height:1.25}
.insights li{margin-bottom:.4rem}
blockquote{margin:.6rem 0;padding:.6rem .8rem;border-left:4px solid #DDD;background:#FAFAFA}
.footer{margin-top:2rem;color:#666;font-size:.9rem}
code{background:#f5f5f5;padding:.1rem .3rem;border-radius:4px}
.preview{margin:1rem 0}
.preview img{max-width:100%;height:auto;border:1px solid #EEE;border-radius:8px}
.topics{display:flex;flex-wrap:wrap;gap:.4rem;margin:0;padding:0;list-style:none}
.topics li{background:#f2f4f7;border:1px solid #e3e7ed;border-radius:12px;padding:.25rem .6rem;font-size:.95rem}
.metadata p{margin:.2rem 0}
.notice{border:1px solid #f0c36d;background:#fff6e5;padding:.6rem .8rem;border-radius:8px;margin:.8rem 0}
.muted{color:#666}
</style>
</head>
<body>
  <h1>{{ report_title }}</h1>
  {% set art = data.artifacts if data.artifacts is defined else {} %}
  {% set summary = art.summary if art.summary is defined else {} %}
  {% set tldr_text = summary.tldr if summary.tldr is defined else data.tldr %}
  {% set exec_summary = summary.executive_summary if summary.executive_summary is defined else data.commentary %}
  {% set claim_map = summary.claim_evidence_map if summary.claim_evidence_map is defined else [] %}
  {% set insights_list = art.insights_final if art.insights_final is defined and art.insights_final else data.insights %}
  {% set quotes_list = art.quotes_final if art.quotes_final is defined and art.quotes_final else [] %}
  {% if not quotes_list and data.quote %}
    {% set quotes_list = [{"text": data.quote.text, "speaker": data.quote.author, "citation": "", "page": data.contents_page_number or 0}] %}
  {% endif %}
  {% set expert_comment = art.expert_comment if art.expert_comment is defined else None %}
  {% set linkedin_post = art.linkedin_post if art.linkedin_post is defined else "" %}
  {% set source_status = art.source_status if art.source_status is defined else {} %}
  {% set not_available = source_status.not_available if source_status.not_available is defined else False %}
  {% set fallback_reason = source_status.reason if source_status.reason is defined else "" %}

  {% if not_available %}
  <div class="notice">Content not available from text{% if fallback_reason %}: {{ fallback_reason }}{% endif %}</div>
  {% endif %}

  {% if preview_png %}
  <div class="preview">
    <h2>Preview</h2>
    <img src="{{ preview_png }}" alt="Page 1 preview of {{ doc_name }}">
  </div>
  {% endif %}

  {% if data.contents_page_number and data.contents_page_number > 0 and data._contents_image %}
  <div class="preview">
    <h2>Contents page (page {{ data.contents_page_number }}){% if data.contents_heading %}: {{ data.contents_heading }}{% endif %}</h2>
    <img src="{{ data._contents_image }}" alt="Contents page screenshot of {{ doc_name }}">
  </div>
  {% endif %}

  {% if data.publisher or (data.taxonomy and data.taxonomy|length > 0) or data.region or data.time_period %}
  <h2>Report metadata</h2>
  <div class="metadata">
  {% if data.publisher %}
  <p><strong>Publisher:</strong> {{ data.publisher }}</p>
  {% endif %}
  {% if data.region %}
  <p><strong>Region:</strong> {{ data.region }}</p>
  {% endif %}
  {% if data.time_period %}
  <p><strong>Time period:</strong> {{ data.time_period }}</p>
  {% endif %}
  </div>
  {% endif %}

  {% if art.toc_topics is defined and art.toc_topics %}
  <h2>Covered topics / TOC</h2>
  <ul class="topics">
    {% for topic in art.toc_topics %}<li>{{ topic }}</li>{% endfor %}
  </ul>
  {% elif not_available %}
  <h2>Covered topics / TOC</h2>
  <p class="muted">Not available from text.</p>
  {% endif %}

  <h2>TL;DR</h2>
  <p>{{ tldr_text }}</p>

  {% if exec_summary %}
    <h2>Executive summary</h2>
    <p>{{ exec_summary }}</p>
    {% if claim_map %}
    <ul>
      {% for claim in claim_map %}
        <li><strong>{{ claim.claim }}</strong>{% if claim.evidence %}: {{ claim.evidence }}{% endif %}</li>
      {% endfor %}
    </ul>
    {% endif %}
  {% endif %}

  <h2>Key data insights</h2>
  {% if insights_list %}
    <ol class="insights">
      {% for insight in insights_list %}
        {% if insight.text is defined %}
          <li>{{ insight.text }}
            {% if insight.metric is defined and (insight.metric.value or insight.metric.unit or insight.metric.timeframe) %}
              <div><em>{{ insight.metric.value }} {{ insight.metric.unit }} {{ insight.metric.timeframe }}</em></div>
            {% endif %}
          </li>
        {% else %}
          <li>{{ insight }}</li>
        {% endif %}
      {% endfor %}
    </ol>
  {% else %}
    <p class="muted">Not available from text.</p>
  {% endif %}

  <h2>Figure</h2>
{% if data._figure_top %}
  <p><img src="{{ data._figure_top }}" alt="Selected figure" style="max-width:100%;height:auto;border:1px solid #EEE;border-radius:8px"></p>
{% elif data._figure_image %}
  <p><img src="{{ data._figure_image }}" alt="Selected figure" style="max-width:100%;height:auto;border:1px solid #EEE;border-radius:8px"></p>
{% endif %}

{% if data._figure_gallery and data._figure_gallery|length > 1 %}
{% endif %}


  <h2>Key quotes</h2>
  {% if quotes_list %}
    {% for quote in quotes_list %}
      <blockquote>"{{ quote.text }}" - <em>{{ quote.speaker if quote.speaker is defined else quote.author }}</em>{% if quote.citation %} ({{ quote.citation }}){% endif %}</blockquote>
    {% endfor %}
  {% else %}
    <p class="muted">Not available from text.</p>
  {% endif %}

  {% if expert_comment %}
  <h2>Expert comment (generated)</h2>
  <p>{{ expert_comment }}</p>
  {% endif %}

  {% if linkedin_post %}
  <h2>LinkedIn post</h2>
  <p>{{ linkedin_post }}</p>
  {% endif %}

  {% if data.commentary and not expert_comment %}
  <h2>Commentary</h2>
  <p>{{ data.commentary }}</p>
  {% endif %}
</body>
</html>
