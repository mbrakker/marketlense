<!doctype html>
{% import "_report_macros.j2" as macros %}
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ view.seo.title }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ view.seo.description }}">
<meta name="robots" content="{{ view.seo.robots }}">
<meta name="drive-file-id" content="{{ file_id }}">
{{ publish_entity_metadata_script|safe }}
<meta name="theme-color" content="#0d3b66">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230d3b66'/%3E%3Cpath d='M18 46V18h8l10 14 10-14h8v28h-8V30L36 44h-2L26 30v16z' fill='white'/%3E%3C/svg%3E">
<meta property="og:site_name" content="Market Lense">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ view.seo.title }}">
<meta property="og:description" content="{{ view.seo.description }}">
{% if view.canonical_url %}<meta property="og:url" content="{{ view.canonical_url }}">{% endif %}
{% if view.seo.primary_image %}<meta property="og:image" content="{{ view.seo.primary_image }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ view.seo.title }}">
<meta name="twitter:description" content="{{ view.seo.description }}">
{% if view.seo.primary_image %}<meta name="twitter:image" content="{{ view.seo.primary_image }}">{% endif %}
{% if view.canonical_url %}<link rel="canonical" href="{{ view.canonical_url }}">{% endif %}
{% if preview_png %}<link rel="preload" as="image" href="{{ preview_png }}">{% endif %}
<script type="application/ld+json">{{ json_ld|tojson }}</script>
<style>
{% include "report.css.j2" %}
</style>
</head>
<body>
  <div class="page-shell">
    <article class="report">
      <header class="hero">
        <div class="hero-split">
          <div class="hero-copy">
            <p class="eyebrow">Market Lense report digest</p>
            <h1>{{ view.report_title }}</h1>
            {% if view.report_identity_items %}
            <p class="report-identity">{{ view.report_identity_items|join(" · ") }}</p>
            {% endif %}
            <p class="hero-subtitle">
              <span class="hero-subtitle-line"><span class="hero-subtitle-label">Publisher:</span> {% if view.publisher %}{{ view.publisher }}{% else %}Not extracted{% endif %}</span>
              <span class="hero-subtitle-line"><span class="hero-subtitle-label">Time Period:</span> {% if view.focus_year %}{{ view.focus_year }}{% else %}Not specified{% endif %}</span>
              <span class="hero-subtitle-line"><span class="hero-subtitle-label">Geography:</span> {% if view.region %}{{ view.region }}{% else %}Not specified{% endif %}</span>
            </p>
            {% if view.hero_meta %}
            <ul class="hero-meta">
              {% for item in view.hero_meta %}
              <li>{{ item }}</li>
              {% endfor %}
            </ul>
            {% endif %}
          </div>
          {% if view.hero_image %}
          <div class="hero-media">
            <figure class="hero-card">
              {{ macros.responsive_image(view.hero_image, loading="eager", fetchpriority="high") }}
              <figcaption>{{ view.hero_image.caption }}</figcaption>
            </figure>
          </div>
          {% endif %}
        </div>
      </header>

      <div class="sticky-nav">
        <div class="reading-progress" aria-hidden="true"><span id="reading-progress-bar"></span></div>
        <nav class="section-nav" aria-label="Digest sections">
          <div class="nav-scroll">
            <ul class="nav-list">
              <li><a href="#section-summary" data-section-link>TL;DR</a></li>
              {% if view.snapshot.facts or view.snapshot.categories or view.snapshot.tags %}<li><a href="#section-snapshot" data-section-link>Report snapshot</a></li>{% endif %}
              {% if view.display.has_topics %}<li><a href="#section-topics" data-section-link>Covered topics</a></li>{% endif %}
              {% if view.summary.executive_summary or view.statuses.summary.status == "abstained" %}<li><a href="#section-executive" data-section-link>Executive summary</a></li>{% endif %}
              <li><a href="#section-insights" data-section-link>Key data insights</a></li>
              {% if view.display.has_editorial or view.display.has_chapters %}<li><a href="#section-editorial" data-section-link>Editorial details</a></li>{% endif %}
              {% if view.display.has_figures %}<li><a href="#section-figures" data-section-link>Figures</a></li>{% endif %}
              <li><a href="#section-quotes" data-section-link>Key quotes</a></li>
              <li><a href="#section-resources" data-section-link>Sources</a></li>
              {% if view.display.has_appendix %}<li><a href="#section-appendix" data-section-link>Appendix</a></li>{% endif %}
            </ul>
          </div>
        </nav>
      </div>

      <main class="content" id="digest-content">
        {% if view.not_available %}
        <section class="panel notice" id="section-notice" data-reveal aria-label="Source status">
          Content not available from text{% if view.fallback_reason %}: {{ view.fallback_reason }}{% endif %}
        </section>
        {% endif %}

        <section class="panel" id="section-summary" data-reveal data-section data-tone="summary" aria-label="TL;DR">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Lead takeaway</p>
              <h2>TL;DR</h2>
            </div>
          </div>
          {% if view.summary.tldr_text %}
            {{ macros.bullet_list(view.summary.tldr_bullets if view.summary.tldr_bullets else [view.summary.tldr_text]) }}
          {% elif view.statuses.summary.status == "abstained" %}
            <p class="muted">TL;DR omitted because evidence support was too weak ({{ view.statuses.summary.reason if view.statuses.summary.reason else "insufficient_evidence_support" }}).</p>
          {% else %}
            <p class="muted">Not available from text.</p>
          {% endif %}
        </section>

        {% if view.snapshot.facts or view.snapshot.categories or view.snapshot.tags %}
        <section class="panel" id="section-snapshot" data-reveal data-section aria-label="Report snapshot">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Metadata below the lead</p>
              <h2>Report snapshot</h2>
            </div>
          </div>
          {% if view.snapshot.facts %}
          <div class="fact-grid">
            {% for fact in view.snapshot.facts %}
            <article class="fact-card">
              <span class="fact-label">{{ fact.label }}</span>
              <p class="fact-value">{{ fact.value }}</p>
            </article>
            {% endfor %}
          </div>
          {% endif %}
          <div class="meta-stack">
            {% if view.snapshot.categories %}
            <article class="meta-row">
              <span class="meta-label">Categories</span>
              {{ macros.chip_list(view.snapshot.categories, tag_acronym_map) }}
            </article>
            {% endif %}
            {% if view.snapshot.tags %}
            <article class="meta-row">
              <span class="meta-label">Tags</span>
              {{ macros.chip_list(view.snapshot.tags, tag_acronym_map) }}
            </article>
            {% endif %}
          </div>
        </section>
        {% endif %}

        {% if view.display.has_topics or view.not_available %}
        <section class="panel" id="section-topics" data-reveal data-section aria-label="Covered topics">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Reading map</p>
              <h2>Covered topics</h2>
            </div>
          </div>
          {% if view.display.has_topics %}
          {{ macros.chip_list(view.topics, tag_acronym_map) }}
          {% if view.topic_briefs %}
          <div class="topic-brief-grid" style="margin-top:18px">
            {% for item in view.topic_briefs %}
            <article class="topic-brief-card">
              <h3>{{ macros.format_chip_label(item.title, tag_acronym_map) }}</h3>
              {% if item.summary %}<p class="summary-copy">{{ item.summary }}</p>{% endif %}
              {% if item.key_points %}{{ macros.bullet_list(item.key_points, class_name="topic-brief-points") }}{% endif %}
            </article>
            {% endfor %}
          </div>
          {% endif %}
          {% else %}
          <p class="muted">Not available from text.</p>
          {% endif %}
        </section>
        {% endif %}

        {% if view.summary.executive_summary or view.statuses.summary.status == "abstained" %}
        <section class="panel" id="section-executive" data-reveal data-section data-tone="summary" aria-label="Executive summary">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Editorial compression</p>
              <h2>Executive summary</h2>
            </div>
          </div>
          {% if view.summary.executive_summary %}
          {{ macros.bullet_list(view.summary.executive_bullets if view.summary.executive_bullets else [view.summary.executive_summary]) }}
          {% elif view.statuses.summary.status == "abstained" %}
          <p class="muted">Executive summary omitted because evidence support was too weak ({{ view.statuses.summary.reason if view.statuses.summary.reason else "insufficient_evidence_support" }}).</p>
          {% endif %}
          {% if view.summary.claim_map %}
          <div style="margin-top:18px">
            <span class="meta-label">Claim evidence map</span>
            <ul class="claim-list" style="margin-top:10px">
              {% for claim in view.summary.claim_map %}
              <li>
                <strong>{{ claim.claim }}</strong>{% if claim.evidence %}: {{ claim.evidence }}{% endif %}
                {% if claim.citation_line %}<div class="citation-micro">{{ claim.citation_line }}</div>{% endif %}
              </li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
        </section>
        {% endif %}

        <section class="panel" id="section-insights" data-reveal data-section data-tone="insights" aria-label="Key data insights">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Signal inventory</p>
              <h2>Key data insights</h2>
            </div>
          </div>
          {% if view.display.has_insights %}
          <ol class="insight-grid">
            {% for insight in view.insights %}
            <li class="insight-card">
              <div class="insight-head">
                <span class="insight-index">{{ loop.index }}</span>
                <div>
                  <p class="insight-text">{{ insight.text }}</p>
                  {% if insight.citation_line %}<div class="citation-micro">{{ insight.citation_line }}</div>{% endif %}
                </div>
              </div>
            </li>
            {% endfor %}
          </ol>
          {% elif view.statuses.insights.status == "abstained" %}
          <p class="muted">Key data insights omitted because evidence support was too weak ({{ view.statuses.insights.reason if view.statuses.insights.reason else "insufficient_evidence_support" }}).</p>
          {% else %}
          <p class="muted">Not available from text.</p>
          {% endif %}
        </section>

        {% if view.display.has_editorial or view.display.has_chapters %}
        <section class="panel" id="section-editorial" data-reveal data-section aria-label="Editorial details">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Provenance and scope</p>
              <h2>Editorial details</h2>
            </div>
          </div>
          <div class="editorial-grid">
            {% for card in view.editorial_cards %}
            <article class="editorial-card">
              <h3>{{ card["label"] }}</h3>
              {% if card["items"] %}
              {{ macros.bullet_list(card["items"], class_name="editorial-list") }}
              {% else %}
              <p class="muted">{{ card["empty"] }}</p>
              {% endif %}
            </article>
            {% endfor %}
          </div>
          {% if view.display.has_chapters %}
          <div style="margin-top:22px">
            <span class="meta-label">Ordered chapters</span>
            <div class="chapter-grid" style="margin-top:12px">
              {% for chapter in view.chapters %}
              <article class="chapter-card">
                <h3>{{ chapter.order }}. {{ chapter.title }}</h3>
                {% if chapter.pages %}
                <p class="chapter-meta">Pages: {{ chapter.pages|join(", ") }}</p>
                {% endif %}
                {% if chapter.summary %}
                <p class="summary-copy">{{ chapter.summary }}</p>
                {% else %}
                <p class="muted">No chapter summary extracted.</p>
                {% endif %}
              </article>
              {% endfor %}
            </div>
          </div>
          {% endif %}
        </section>
        {% endif %}

        {% if view.display.has_figures %}
        <section class="panel" id="section-figures" data-reveal data-section data-tone="figures" aria-label="Figure carousel">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Visual evidence</p>
              <h2>Figures</h2>
            </div>
          </div>
          <div class="figure-carousel" data-carousel>
            <div class="carousel-shell">
              <button type="button" class="carousel-btn prev" aria-label="Previous figure" data-carousel-prev>&lsaquo;</button>
              <div class="carousel-slides" tabindex="0">
                {% for slide in view.figures.slides %}
                <figure class="carousel-slide{% if loop.first %} is-active{% endif %}" data-carousel-slide="{{ loop.index }}">
                  {{ macros.responsive_image(slide, loading="eager" if loop.first else "lazy", fetchpriority="high" if loop.first else "auto") }}
                  <figcaption class="carousel-caption">{{ slide.caption }}</figcaption>
                </figure>
                {% endfor %}
              </div>
              <button type="button" class="carousel-btn next" aria-label="Next figure" data-carousel-next>&rsaquo;</button>
            </div>
            <div class="carousel-toolbar">
              <span class="carousel-count" data-carousel-count>1 / {{ view.figures.slides|length }}</span>
              <button type="button" class="lightbox-open" data-lightbox-open>Open fullscreen</button>
            </div>
            {% if view.figures.slides|length > 1 %}
            <div class="carousel-thumbs" role="tablist" aria-label="Figure thumbnails">
              {% for slide in view.figures.slides %}
              <button type="button" class="carousel-thumb{% if loop.first %} is-active{% endif %}" data-carousel-thumb="{{ loop.index }}" aria-label="Open figure {{ loop.index }}">
                {{ macros.responsive_image(slide.thumb) }}
              </button>
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </section>
        {% endif %}

        <section class="panel" id="section-quotes" data-reveal data-section data-tone="quotes" aria-label="Key quotes">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Verbatim signals</p>
              <h2>Key quotes</h2>
            </div>
          </div>
          {% if view.display.has_quotes %}
          <ul class="quote-grid">
            {% for quote in view.quotes %}
            <li>
              <figure class="quote-card">
                <blockquote><p>"{{ quote.text }}"</p></blockquote>
                <figcaption class="quote-byline">
                  <span class="quote-author">{{ quote.author }}</span>
                  {% if quote.citation %}<span class="quote-citation">{{ quote.citation }}</span>{% endif %}
                </figcaption>
                {% if quote.citation_line %}<div class="citation-micro">{{ quote.citation_line }}</div>{% endif %}
              </figure>
            </li>
            {% endfor %}
          </ul>
          {% elif view.statuses.quotes.status == "abstained" %}
          <p class="muted">Key quotes omitted because evidence support was too weak ({{ view.statuses.quotes.reason if view.statuses.quotes.reason else "insufficient_evidence_support" }}).</p>
          {% else %}
          <p class="muted">Not available from text.</p>
          {% endif %}
        </section>

        {% if view.commentary and view.commentary != view.summary.executive_summary and not view.expert_comment %}
        <section class="panel" id="section-commentary" data-reveal data-section aria-label="Commentary">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Additional commentary</p>
              <h2>Commentary</h2>
            </div>
          </div>
          <div class="prose-block" data-chunk-prose>{{ view.commentary }}</div>
        </section>
        {% endif %}

        <section class="panel" id="section-resources" data-reveal data-section aria-label="Related resources">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Traceability</p>
              <h2>Related resources</h2>
            </div>
          </div>
          {% if not view.canonical_url and not view.source_url %}
          <p class="muted">Source URL was not available in the extracted report metadata.</p>
          {% endif %}
          <ul class="resource-list">
            {% if view.canonical_url %}<li><a href="{{ view.canonical_url }}" rel="noopener" target="_blank">Canonical/source URL</a></li>{% endif %}
            {% if view.source_url and view.source_url != view.canonical_url %}<li><a href="{{ view.source_url }}" rel="noopener" target="_blank">Original source link</a></li>{% endif %}
            <li><a href="#section-summary">Back to TL;DR</a></li>
            <li><a href="#section-insights">Jump to key insights</a></li>
          </ul>
        </section>

        {% if view.expert_comment or view.linkedin_post or view.statuses.expert.status == "abstained" or view.statuses.linkedin.status == "abstained" %}
        <section class="panel" id="section-appendix" data-reveal data-section aria-label="Appendix">
          <div class="panel-header">
            <div>
              <p class="panel-kicker">Generated extras</p>
              <h2>Appendix</h2>
            </div>
          </div>
          {% if view.expert_comment %}
          <h3>Expert comment (generated)</h3>
          <div class="prose-block" data-chunk-prose>{{ view.expert_comment }}</div>
          {% elif view.statuses.expert.status == "abstained" %}
          <p class="muted">Expert comment omitted because evidence support was too weak ({{ view.statuses.expert.reason if view.statuses.expert.reason else "insufficient_evidence_support" }}).</p>
          {% endif %}
          {% if view.linkedin_post %}
          <h3 style="margin-top:18px">LinkedIn post</h3>
          <div class="prose-block" data-chunk-prose>{{ view.linkedin_post }}</div>
          {% elif view.statuses.linkedin.status == "abstained" %}
          <p class="muted">LinkedIn post omitted because evidence support was too weak ({{ view.statuses.linkedin.reason if view.statuses.linkedin.reason else "insufficient_evidence_support" }}).</p>
          {% endif %}
        </section>
        {% endif %}
      </main>

      <div class="lightbox" id="figure-lightbox" hidden aria-hidden="true">
        <div class="lightbox-top">
          <button type="button" class="lightbox-close" data-lightbox-close>Close</button>
        </div>
        <figure>
          <img src="" alt="" id="lightbox-image" width="{{ view.figures.lightbox_width }}" height="{{ view.figures.lightbox_height }}">
          <figcaption id="lightbox-caption"></figcaption>
        </figure>
      </div>

      <footer class="footer">
        Generated by Market Lense. File ID: <code>{{ file_id }}</code>.
      </footer>
    </article>
  </div>
  <script>
  (function () {
    var progressBar = document.getElementById("reading-progress-bar");
    var navLinks = Array.prototype.slice.call(document.querySelectorAll("[data-section-link]"));
    var sections = Array.prototype.slice.call(document.querySelectorAll("[data-section]"));
    var revealPanels = Array.prototype.slice.call(document.querySelectorAll("[data-reveal]"));
    var lightbox = document.getElementById("figure-lightbox");
    var lightboxImage = document.getElementById("lightbox-image");
    var lightboxCaption = document.getElementById("lightbox-caption");
    var lightboxClose = document.querySelector("[data-lightbox-close]");

    var updateProgress = function () {
      if (!progressBar) {
        return;
      }
      var top = window.scrollY || window.pageYOffset || 0;
      var total = Math.max((document.documentElement.scrollHeight || 0) - window.innerHeight, 1);
      var pct = Math.max(0, Math.min(100, (top / total) * 100));
      progressBar.style.width = pct + "%";
    };

    var activateLink = function (id) {
      navLinks.forEach(function (link) {
        var active = link.getAttribute("href") === "#" + id;
        link.classList.toggle("is-active", active);
      });
    };

    var openLightbox = function (slide) {
      if (!slide || !lightbox || !lightboxImage || !lightboxCaption) {
        return;
      }
      var img = slide.querySelector("img");
      var caption = slide.querySelector("figcaption");
      if (!img) {
        return;
      }
      lightboxImage.src = img.currentSrc || img.src || "";
      lightboxImage.alt = img.alt || "Figure";
      lightboxCaption.textContent = caption ? caption.textContent : "";
      lightbox.hidden = false;
      lightbox.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };

    var closeLightbox = function () {
      if (!lightbox) {
        return;
      }
      lightbox.hidden = true;
      lightbox.setAttribute("aria-hidden", "true");
      if (lightboxImage) {
        lightboxImage.src = "";
      }
      document.body.style.overflow = "";
    };

    if (lightboxClose) {
      lightboxClose.addEventListener("click", closeLightbox);
    }
    if (lightbox) {
      lightbox.addEventListener("click", function (event) {
        if (event.target === lightbox) {
          closeLightbox();
        }
      });
    }

    var chunkTextBlock = function (element) {
      var text = (element.textContent || "").trim();
      if (!text || text.length < 320) {
        return;
      }
      var parts = [];
      var lines = text.split(/\n+/).map(function (line) { return line.trim(); }).filter(Boolean);
      if (lines.length > 1) {
        parts = lines;
      } else {
        var sentences = text.match(/[^.!?]+[.!?]*/g) || [text];
        var bucket = "";
        sentences.forEach(function (sentence) {
          if ((bucket + " " + sentence).trim().length > 260 && bucket) {
            parts.push(bucket.trim());
            bucket = sentence;
          } else {
            bucket = (bucket ? bucket + " " : "") + sentence;
          }
        });
        if (bucket.trim()) {
          parts.push(bucket.trim());
        }
      }
      if (parts.length < 2) {
        return;
      }
      element.innerHTML = "";
      parts.forEach(function (part) {
        var paragraph = document.createElement("p");
        paragraph.className = "prose-paragraph";
        paragraph.textContent = part;
        element.appendChild(paragraph);
      });
    };

    document.querySelectorAll("[data-chunk-prose]").forEach(chunkTextBlock);

    if ("IntersectionObserver" in window) {
      var sectionObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            activateLink(entry.target.id);
          }
        });
      }, { rootMargin: "-35% 0px -45% 0px", threshold: 0.01 });
      sections.forEach(function (section) { sectionObserver.observe(section); });

      var revealObserver = new IntersectionObserver(function (entries, observer) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: "0px 0px -10% 0px", threshold: 0.1 });
      revealPanels.forEach(function (panel) { revealObserver.observe(panel); });
    } else {
      revealPanels.forEach(function (panel) { panel.classList.add("is-visible"); });
    }

    var initCarousel = function (carousel) {
      var slides = Array.prototype.slice.call(carousel.querySelectorAll("[data-carousel-slide]"));
      var thumbs = Array.prototype.slice.call(carousel.querySelectorAll("[data-carousel-thumb]"));
      var prev = carousel.querySelector("[data-carousel-prev]");
      var next = carousel.querySelector("[data-carousel-next]");
      var count = carousel.querySelector("[data-carousel-count]");
      var open = carousel.querySelector("[data-lightbox-open]");
      var stage = carousel.querySelector(".carousel-slides");
      var index = 0;

      var setSlide = function (target) {
        if (!slides.length) {
          return;
        }
        index = ((target % slides.length) + slides.length) % slides.length;
        slides.forEach(function (slide, i) {
          slide.classList.toggle("is-active", i === index);
        });
        thumbs.forEach(function (thumb, i) {
          thumb.classList.toggle("is-active", i === index);
        });
        if (count) {
          count.textContent = (index + 1) + " / " + slides.length;
        }
        if (prev) {
          prev.disabled = slides.length <= 1;
        }
        if (next) {
          next.disabled = slides.length <= 1;
        }
      };

      if (prev) {
        prev.addEventListener("click", function () { setSlide(index - 1); });
      }
      if (next) {
        next.addEventListener("click", function () { setSlide(index + 1); });
      }
      thumbs.forEach(function (thumb, i) {
        thumb.addEventListener("click", function () { setSlide(i); });
      });
      slides.forEach(function (slide, i) {
        slide.addEventListener("click", function () { setSlide(i); openLightbox(slides[index]); });
      });
      if (open) {
        open.addEventListener("click", function () { openLightbox(slides[index]); });
      }
      if (stage) {
        stage.addEventListener("keydown", function (event) {
          if (event.key === "ArrowLeft") {
            event.preventDefault();
            setSlide(index - 1);
          } else if (event.key === "ArrowRight") {
            event.preventDefault();
            setSlide(index + 1);
          }
        });
        var touchStartX = null;
        stage.addEventListener("touchstart", function (event) {
          touchStartX = event.changedTouches[0].clientX;
        }, { passive: true });
        stage.addEventListener("touchend", function (event) {
          if (touchStartX === null) {
            return;
          }
          var delta = event.changedTouches[0].clientX - touchStartX;
          if (Math.abs(delta) > 45) {
            setSlide(index + (delta < 0 ? 1 : -1));
          }
          touchStartX = null;
        }, { passive: true });
      }

      setSlide(0);
    };

    document.querySelectorAll("[data-carousel]").forEach(initCarousel);

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape") {
        closeLightbox();
      }
    });
    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();
    if (sections.length > 0) {
      activateLink(sections[0].id);
    }
  })();
  </script>
</body>
</html>
