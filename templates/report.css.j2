:root{
  --navy:#082b52;
  --navy-2:#041528;
  --blue:#005cc8;
  --sky:#eaf3ff;
  --line:#dbe4ee;
  --paper:#f7f9fc;
  --ink:#071a33;
  --muted:#61738a;
  --green:#12a37b;
  --radius:8px;
  --shadow:0 18px 48px rgba(8,43,82,.12);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  color:var(--ink);
  background:var(--paper);
  font-family:Inter, "Segoe UI", Arial, sans-serif;
  line-height:1.55;
  text-rendering:optimizeLegibility;
}
body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(circle at 80% 12%, rgba(0,92,200,.1), transparent 24%),
    linear-gradient(90deg, rgba(8,43,82,.035) 1px, transparent 1px),
    linear-gradient(180deg, rgba(8,43,82,.035) 1px, transparent 1px);
  background-size:auto, 88px 88px, 88px 88px;
  mask-image:linear-gradient(180deg, #000 0%, transparent 58%);
}
img{max-width:100%;height:auto;display:block}
a{color:var(--blue);text-decoration:none}
a:hover{text-decoration:underline}
.report-document{display:block}
.skip-link{
  position:absolute;
  inset-block-start:10px;
  inset-inline-start:10px;
  z-index:100;
  transform:translateY(-160%);
  background:#fff;
  color:var(--navy);
  padding:10px 14px;
  border:1px solid var(--line);
}
.skip-link:focus{transform:none}
.site-header{
  position:sticky;
  top:0;
  z-index:50;
  background:rgba(255,255,255,.92);
  backdrop-filter:blur(18px);
  border-bottom:1px solid var(--line);
}
.header-inner,
.hero-inner,
.page-grid,
.footer-inner{
  width:min(100% - 48px, 1480px);
  margin:0 auto;
}
.header-inner{
  min-height:68px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:26px;
}
.brand{
  display:inline-grid;
  gap:2px;
  color:var(--navy);
  min-width:max-content;
}
.brand-mark{
  font-size:1.72rem;
  line-height:1;
  font-weight:790;
  letter-spacing:0;
}
.brand-mark span{color:var(--blue)}
.brand-rule{
  display:block;
  inline-size:168px;
  block-size:3px;
  background:linear-gradient(90deg, rgba(8,43,82,0), var(--navy));
  position:relative;
}
.brand-rule::after{
  content:"";
  position:absolute;
  inset-inline-end:-4px;
  inset-block-start:50%;
  inline-size:10px;
  block-size:10px;
  border-radius:50%;
  background:var(--navy);
  transform:translateY(-50%);
}
.top-nav{
  display:flex;
  align-items:center;
  gap:30px;
  color:#26394f;
  font-size:.96rem;
}
.top-nav a{color:#26394f}
.top-nav a[aria-current="page"]{
  color:var(--blue);
  box-shadow:inset 0 -2px 0 var(--blue);
  padding-block:23px 20px;
}
.header-meta{
  color:var(--muted);
  font-size:.92rem;
  white-space:nowrap;
  max-width:320px;
  overflow:hidden;
  text-overflow:ellipsis;
}
.progress{block-size:3px}
.progress span{
  display:block;
  block-size:100%;
  inline-size:0;
  background:linear-gradient(90deg, var(--blue), var(--navy));
}
.hero{
  background:
    radial-gradient(circle at 78% 16%, rgba(0,92,200,.18), transparent 26%),
    linear-gradient(135deg, #fff 0%, #f7fbff 52%, #edf5fd 100%);
  border-bottom:1px solid var(--line);
}
.hero-inner{
  display:grid;
  grid-template-columns:minmax(0, 1.04fr) minmax(360px, .76fr);
  gap:34px 68px;
  align-items:end;
  padding:58px 0 54px;
}
.hero-intro{
  grid-column:1 / -1;
}
.hero-meta-block{
  align-self:start;
}
.eyebrow{
  color:var(--blue);
  text-transform:uppercase;
  letter-spacing:.18em;
  font-size:.78rem;
  font-weight:760;
  margin:0 0 24px;
}
.hero h1{
  font-family:Georgia, "Times New Roman", serif;
  font-size:clamp(3rem, 5.2vw, 5.75rem);
  line-height:1;
  letter-spacing:0;
  max-width:930px;
  overflow-wrap:break-word;
  margin:0;
}
.hero-thesis{
  max-width:800px;
  margin:28px 0 0;
  font-size:clamp(1.08rem, 1.18vw, 1.34rem);
  line-height:1.58;
  color:#26394f;
}
.meta-row{
  list-style:none;
  display:flex;
  flex-wrap:wrap;
  gap:10px 18px;
  margin:30px 0 0;
  padding:0;
  color:var(--muted);
  font-size:.92rem;
}
.meta-pill{
  display:inline-flex;
  align-items:center;
  gap:9px;
}
.meta-pill::before{
  content:"";
  inline-size:5px;
  block-size:5px;
  border-radius:50%;
  background:var(--blue);
}
.signal-panel{
  color:#fff;
  background:var(--navy);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  overflow:hidden;
}
.signal-top{
  min-height:252px;
  padding:28px;
  display:grid;
  align-content:center;
  position:relative;
  isolation:isolate;
  overflow:hidden;
  background:
    radial-gradient(circle at 18% 12%, rgba(0,92,200,.9), transparent 24%),
    linear-gradient(145deg, #06294e 0%, #071d38 54%, #041528 100%);
}
.signal-top::before{
  content:"";
  position:absolute;
  inset:0 0 0 auto;
  inline-size:42%;
  opacity:.36;
  background:
    linear-gradient(90deg, transparent 0 16%, rgba(255,255,255,.16) 16% 18%, transparent 18% 100%),
    linear-gradient(180deg, transparent 0 18%, rgba(255,255,255,.12) 18% 19%, transparent 19% 100%);
  background-size:34px 34px;
  transform:skewX(-8deg);
  transform-origin:bottom right;
}
.signal-top::after{
  content:"";
  position:absolute;
  inset:auto -16% -26% 32%;
  z-index:-1;
  block-size:150px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.18);
  box-shadow:0 0 0 42px rgba(255,255,255,.035), 0 0 0 86px rgba(255,255,255,.025);
}
.signal-top h2{
  font-size:clamp(2rem, 4vw, 3.4rem);
  line-height:.96;
  margin:8px 0 0;
  max-width:520px;
}
.signal-top p{
  max-width:460px;
  color:#dcecff;
  font-weight:620;
}
.signal-stat-grid{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  background:#fff;
  color:var(--navy);
  border:1px solid var(--line);
  border-top:0;
}
.signal-stat{
  padding:18px 18px 20px;
  border-right:1px solid var(--line);
}
.signal-stat:last-child{border-right:0}
.signal-stat strong{
  display:block;
  font-size:1.55rem;
  line-height:1;
}
.signal-stat span{
  display:block;
  margin-top:8px;
  color:var(--muted);
  font-size:.88rem;
}
.hero-score{
  display:grid;
  grid-template-columns:minmax(132px, .52fr) minmax(0, 1fr);
  gap:0;
  background:#fff;
  color:var(--navy);
  border:1px solid var(--line);
  border-top:0;
  border-radius:0 0 var(--radius) var(--radius);
}
.hero-score-main{
  padding:18px;
  border-right:1px solid var(--line);
  display:grid;
  align-content:start;
  gap:7px;
}
.score-eyebrow{
  color:var(--blue);
  text-transform:uppercase;
  letter-spacing:.16em;
  font-size:.68rem;
  font-weight:790;
}
.hero-score-main strong{
  font-size:1.5rem;
  line-height:1;
}
.hero-score-main span:last-child,
.score-dimension b{
  color:var(--muted);
  font-size:.82rem;
}
.score-pin{
  inline-size:78px;
  block-size:10px;
  position:relative;
  margin-top:4px;
}
.score-pin::before{
  content:"";
  position:absolute;
  inset-inline:0 8px;
  inset-block-start:4px;
  block-size:2px;
  background:linear-gradient(90deg, rgba(8,43,82,0), var(--navy));
}
.score-pin::after{
  content:"";
  position:absolute;
  inset-inline-end:0;
  inset-block-start:0;
  inline-size:10px;
  block-size:10px;
  border-radius:50%;
  background:var(--navy);
}
.score-dimensions{
  padding:14px 16px;
  display:grid;
  grid-template-columns:repeat(2, minmax(0, 1fr));
  gap:8px;
}
.score-dimension{
  display:grid;
  grid-template-columns:minmax(0, 1fr) auto;
  align-items:center;
  gap:6px 8px;
  min-height:30px;
  color:#34475a;
  font-size:.79rem;
  line-height:1.2;
}
.score-dimension span{
  display:flex;
  align-items:center;
  gap:8px;
}
.score-dimension span::before{
  content:"";
  inline-size:7px;
  block-size:7px;
  flex:0 0 auto;
  border-radius:50%;
  background:var(--blue);
  opacity:.72;
}
.score-dimension i{
  grid-column:1 / -1;
  display:block;
  block-size:4px;
  border-radius:999px;
  background:linear-gradient(90deg, var(--blue) var(--fill), #e6edf4 var(--fill));
}
.page-grid{
  display:grid;
  grid-template-columns:240px minmax(0, 1fr);
  gap:48px;
  padding:44px 0 96px;
}
.toc{
  position:sticky;
  top:94px;
  align-self:start;
  display:grid;
  gap:18px;
  color:var(--muted);
}
.toc-title{
  color:var(--navy);
  text-transform:uppercase;
  letter-spacing:.18em;
  font-size:.76rem;
  font-weight:760;
  margin:0;
}
.toc nav{display:grid}
.toc a{
  color:var(--muted);
  border-bottom:1px solid var(--line);
  padding:10px 0;
}
.toc a.is-active{
  color:var(--blue);
  border-bottom-color:var(--blue);
}
.content{display:grid}
.section{
  border-top:1px solid var(--line);
  padding:56px 0;
}
.section:first-child{
  border-top:0;
  padding-top:0;
}
.notice{
  background:#fff9ed;
  border:1px solid #f0d9a1;
  border-radius:var(--radius);
  padding:20px;
}
.section-head{
  display:grid;
  grid-template-columns:180px minmax(0, 1fr);
  gap:36px;
  margin-bottom:28px;
}
.section-kicker{
  color:var(--blue);
  text-transform:uppercase;
  letter-spacing:.18em;
  font-size:.76rem;
  font-weight:780;
  margin:0;
}
.section-kicker::after{
  content:"";
  display:block;
  inline-size:72px;
  block-size:10px;
  margin-top:13px;
  background:
    radial-gradient(circle at right center, var(--navy) 0 5px, transparent 5.5px),
    linear-gradient(90deg, rgba(8,43,82,0), var(--navy)) left 4px / calc(100% - 5px) 2px no-repeat;
}
.section h2{
  color:var(--navy);
  font-size:clamp(2rem, 3.25vw, 3.65rem);
  line-height:1.04;
  letter-spacing:0;
  max-width:100%;
  text-wrap:balance;
  margin:0;
}
.section-lede{
  margin:16px 0 0;
  color:#33465a;
  font-size:1.08rem;
  max-width:100%;
  text-wrap:pretty;
}
.summary-panel{
  display:grid;
  grid-template-columns:minmax(220px, .68fr) minmax(0, 1.32fr);
  border:1px solid var(--line);
  border-radius:var(--radius);
  background:#fff;
  overflow:hidden;
  box-shadow:0 10px 30px rgba(8,43,82,.045);
  margin-bottom:24px;
}
.summary-panel-executive{
  grid-template-columns:1fr;
}
.summary-panel-executive .summary-body{
  border-left:6px solid var(--navy);
  padding:28px 32px;
}
.summary-tldr{
  background:var(--navy);
  color:#fff;
  padding:24px;
  display:grid;
  align-content:start;
  gap:16px;
  position:relative;
  overflow:hidden;
}
.summary-tldr::after{
  content:"";
  position:absolute;
  inset:auto -20% -38% 30%;
  block-size:150px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.16);
  box-shadow:0 0 0 40px rgba(255,255,255,.035), 0 0 0 82px rgba(255,255,255,.025);
}
.summary-label{
  color:#d9ebff;
  text-transform:uppercase;
  letter-spacing:.16em;
  font-size:.72rem;
  font-weight:790;
}
.summary-tldr p{
  position:relative;
  z-index:1;
  font-size:1.16rem;
  line-height:1.42;
  font-weight:680;
  margin:0;
}
.summary-body{
  padding:24px;
  display:grid;
  gap:12px;
}
.summary-body h3{
  color:var(--navy);
  font-size:1.22rem;
  margin:0;
}
.summary-body p{
  color:#33465a;
  line-height:1.62;
  margin:0;
}
.claim-strip{
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  border:1px solid var(--line);
  background:#fff;
}
.claim-strip article{
  padding:20px;
  border-right:1px solid var(--line);
}
.claim-strip article:last-child{border-right:0}
.claim-strip span{
  color:var(--muted);
  font-weight:790;
}
.claim-strip p{margin:10px 0 0}
.claim-strip small{
  display:block;
  margin-top:8px;
  color:var(--muted);
}
.finding-list{
  display:grid;
  grid-template-columns:repeat(2, minmax(0, 1fr));
  gap:18px;
}
.finding-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:24px;
  box-shadow:0 8px 26px rgba(8,43,82,.045);
}
.card-meta{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-bottom:16px;
}
.badge{
  display:inline-flex;
  align-items:center;
  min-height:24px;
  padding:3px 9px;
  border-radius:999px;
  background:var(--sky);
  color:var(--blue);
  font-size:.76rem;
  font-weight:700;
}
.badge.green{
  color:#006b53;
  background:#e8f6f2;
}
.finding-card h3{
  color:var(--navy);
  font-size:1.12rem;
  line-height:1.22;
  margin:0;
}
.candidate-toolbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  margin-bottom:16px;
}
.carousel-controls{display:flex;gap:8px}
.carousel-button{
  inline-size:38px;
  block-size:38px;
  border:1px solid var(--line);
  border-radius:50%;
  background:#fff;
  color:var(--navy);
  cursor:pointer;
  font:inherit;
  font-weight:780;
}
.carousel-button:focus-visible,
.download-link:focus-visible{
  outline:3px solid rgba(0,92,200,.35);
  outline-offset:3px;
}
.visual-candidate-carousel{
  display:flex;
  gap:16px;
  overflow-x:auto;
  scroll-snap-type:x mandatory;
  overscroll-behavior-inline:contain;
  scrollbar-gutter:stable;
  padding:2px 2px 14px;
}
.visual-candidate-slide{
  flex:0 0 min(520px, 88%);
  scroll-snap-align:start;
}
.visual-candidate-card{
  min-height:360px;
  display:grid;
  grid-template-rows:240px auto;
  gap:0;
  align-content:start;
  background:#fff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
  box-shadow:0 8px 26px rgba(8,43,82,.045);
  margin:0;
}
.visual-candidate-card img{
  inline-size:100%;
  block-size:100%;
  object-fit:cover;
  object-position:center;
  background:#dfeaf5;
}
.visual-candidate-copy{
  padding:18px 20px 20px;
  display:grid;
  gap:10px;
}
.candidate-score{
  color:var(--blue);
  font-weight:800;
}
.visual-candidate-card h3{
  color:var(--navy);
  font-size:1.16rem;
  line-height:1.18;
  margin:0;
}
.tag-grid{
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  gap:14px;
}
.tag-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:20px;
}
.tag-card h3{
  color:var(--navy);
  font-size:1.05rem;
  margin:0 0 10px;
  text-transform:capitalize;
}
.tag-card p{
  color:#35485c;
  font-size:.95rem;
  margin:0;
}
.quote-board{
  display:grid;
  grid-template-columns:minmax(260px, .82fr) minmax(0, 1.18fr);
  gap:18px;
}
.quote-feature{
  min-height:420px;
  margin:0;
  padding:28px;
  display:grid;
  align-content:end;
  color:#fff;
  border-radius:var(--radius);
  overflow:hidden;
  background:
    radial-gradient(circle at 22% 18%, rgba(0,92,200,.72), transparent 28%),
    linear-gradient(145deg, #06294e, #041528);
  box-shadow:var(--shadow);
}
.quote-feature blockquote{
  font-family:Georgia, "Times New Roman", serif;
  font-size:clamp(1.6rem, 2.3vw, 2.8rem);
  line-height:1.05;
  margin:0;
}
.quote-feature figcaption{
  color:#d8e9fb;
  margin-top:18px;
}
.quote-stack{
  display:grid;
  gap:12px;
}
.quote-card{
  margin:0;
  background:#fff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:18px;
}
.quote-card blockquote{margin:0;color:#26394f}
.quote-card figcaption{margin-top:10px;color:var(--muted)}
.expert-panel{
  display:grid;
  grid-template-columns:minmax(220px, .54fr) minmax(0, 1.46fr);
  gap:0;
  background:#fff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
  box-shadow:var(--shadow);
}
.expert-aside{
  background:var(--navy);
  color:#fff;
  padding:28px;
  display:grid;
  align-content:space-between;
  gap:28px;
}
.expert-avatar{
  inline-size:64px;
  block-size:64px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#fff;
  color:var(--navy);
  font-weight:840;
  font-size:1.15rem;
}
.expert-aside h3{
  font-size:1.45rem;
  line-height:1.12;
  margin:0 0 10px;
}
.expert-aside p{color:#d8e9fb;margin:0}
.expert-copy{
  padding:30px;
  display:grid;
  gap:18px;
}
.expert-copy p{color:#26394f;margin:0}
.prose-paragraph + .prose-paragraph{margin-top:14px}
.linkedin-details{
  margin-top:18px;
  border:1px solid #b9d4ee;
  border-radius:var(--radius);
  background:#fff;
}
.linkedin-summary{
  background:#f5faff;
  padding:16px 20px;
  cursor:pointer;
}
.linkedin-label{
  display:flex;
  align-items:center;
  gap:12px;
}
.linkedin-logo{
  inline-size:28px;
  block-size:28px;
  border-radius:5px;
  display:grid;
  place-items:center;
  background:#0a66c2;
  color:#fff;
  font-weight:850;
  letter-spacing:0;
  font-size:1rem;
}
.linkedin-post{
  padding:0 22px 22px;
  color:#26394f;
  white-space:pre-line;
}
.topic-map{
  display:grid;
  gap:10px;
}
details{
  background:#fff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
}
summary{
  cursor:pointer;
  padding:20px 22px;
  color:var(--navy);
  font-weight:780;
}
.topic-body{
  padding:0 22px 22px;
  color:#34475a;
}
.topic-body p + p{margin-top:10px}
.chip-list{
  list-style:none;
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  padding:0;
  margin:0;
}
.chip{
  display:inline-flex;
  background:var(--sky);
  border:1px solid rgba(0,92,200,.14);
  color:var(--blue);
  border-radius:999px;
  padding:6px 10px;
  font-size:.85rem;
  font-weight:700;
}
.download-card{
  background:linear-gradient(135deg, #f6fbff, #fff);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:22px;
  margin-bottom:16px;
}
.download-card h3{
  color:var(--navy);
  font-size:1.25rem;
  margin:0 0 8px;
}
.download-card p{
  color:#34475a;
  margin:0 0 16px;
}
.download-actions{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}
.download-link{
  display:inline-flex;
  align-items:center;
  gap:10px;
  min-height:42px;
  padding:0 16px;
  border-radius:6px;
  background:var(--blue);
  color:#fff;
  font-weight:760;
}
.download-link.secondary{
  background:#fff;
  color:var(--blue);
  border:1px solid #b9d4ee;
}
.download-link:hover{
  color:#fff;
  text-decoration:none;
  background:#004fae;
}
.download-link.secondary:hover{
  color:var(--blue);
  background:#f5faff;
}
.source-layout{
  display:grid;
  grid-template-columns:minmax(260px, 380px) minmax(0, 1fr);
  gap:34px;
  align-items:start;
}
.source-frame{
  background:#fff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:12px;
  box-shadow:var(--shadow);
  margin:0;
}
.source-frame img{
  border-radius:4px;
  border:1px solid var(--line);
}
.source-frame figcaption{
  color:var(--muted);
  font-size:.86rem;
  margin-top:10px;
}
.method-list{display:grid;gap:12px}
.method-item{
  display:grid;
  grid-template-columns:44px minmax(0, 1fr);
  gap:16px;
  padding:18px 0;
  border-bottom:1px solid var(--line);
}
.method-item:last-child{border-bottom:0}
.method-num{
  display:grid;
  place-items:center;
  inline-size:44px;
  block-size:44px;
  border-radius:50%;
  background:var(--sky);
  color:var(--blue);
  font-weight:800;
}
.method-item p{color:#34475a;margin:0}
.muted{color:var(--muted)}
.footer{
  border-top:1px solid var(--line);
  color:var(--muted);
  padding:28px 0;
  font-size:.86rem;
}
.footer-inner{
  display:flex;
  justify-content:space-between;
  gap:20px;
  flex-wrap:wrap;
}
@media (max-width:1100px){
  .hero-inner,
  .page-grid,
  .quote-board,
  .summary-panel,
  .claim-strip,
  .expert-panel,
  .source-layout{grid-template-columns:1fr}
  .toc{
    position:static;
    overflow-x:auto;
    padding-bottom:8px;
  }
  .toc nav{
    display:flex;
    gap:16px;
    min-width:max-content;
  }
  .toc a{padding:6px 0}
  .section-head{grid-template-columns:1fr;gap:12px}
  .finding-list,
  .tag-grid{grid-template-columns:repeat(2, minmax(0, 1fr))}
  .claim-strip article{
    border-right:0;
    border-bottom:1px solid var(--line);
  }
  .claim-strip article:last-child{border-bottom:0}
}
@media (max-width:720px){
  body{font-size:15px}
  .header-inner,
  .hero-inner,
  .page-grid,
  .footer-inner{
    width:min(100% - 28px, 1480px);
  }
  .header-inner{min-height:62px}
  .top-nav,.header-meta{display:none}
  .brand-mark{font-size:1.34rem}
  .brand-rule{inline-size:122px}
  .hero-inner{padding:46px 0 38px;gap:28px}
  .hero h1{
    font-size:clamp(2.2rem, 10.5vw, 3.2rem);
    line-height:1.04;
    letter-spacing:0;
  }
  .hero-thesis{font-size:1rem}
  .meta-row{gap:8px}
  .meta-pill{
    inline-size:100%;
    justify-content:flex-start;
  }
  .signal-top{min-height:250px;padding:22px}
  .signal-stat-grid,
  .hero-score,
  .finding-list,
  .tag-grid{grid-template-columns:1fr}
  .hero-score-main{
    border-right:0;
    border-bottom:1px solid var(--line);
  }
  .score-dimensions{grid-template-columns:1fr}
  .signal-stat{
    border-right:0;
    border-bottom:1px solid var(--line);
  }
  .signal-stat:last-child{border-bottom:0}
  .page-grid{gap:28px;padding:24px 0 60px}
  .section{padding:42px 0}
  .candidate-toolbar{align-items:flex-start}
  .visual-candidate-slide{flex-basis:92%}
  .expert-aside,
  .expert-copy{padding:22px}
  .quote-feature{min-height:360px;padding:22px}
  summary{padding:18px}
  .topic-body{padding:0 18px 18px}
}
@media print{
  .site-header,.toc{display:none}
  body{background:#fff}
  body::before{display:none}
  .hero{background:#fff}
  .hero-inner,.page-grid,.footer-inner{width:100%;padding-inline:0}
  .section{content-visibility:visible;contain-intrinsic-size:auto}
}
