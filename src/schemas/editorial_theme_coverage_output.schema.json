{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "theme_coverage",
    "report_completeness",
    "diagnosis",
    "material_gaps",
    "original_essential_obligation_assessments"
  ],
  "properties": {
    "theme_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme", "status", "supporting_insight_ids", "explanation"],
        "properties": {
          "theme": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["covered", "partial", "uncovered", "redundant_optional"]
          },
          "supporting_insight_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    },
    "report_completeness": {
      "type": "string",
      "enum": ["complete", "incomplete", "uncertain"]
    },
    "diagnosis": {
      "type": "string",
      "enum": [
        "planned_theme_execution",
        "material_report_completeness",
        "redundant_optional_theme",
        "infeasible_plan",
        "insufficient_evidence"
      ]
    },
    "material_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verified_fact_ids",
          "evidence_ids",
          "final_insight_ids",
          "explanation"
        ],
        "properties": {
          "verified_fact_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "final_insight_ids": {"type": "array", "items": {"type": "string"}},
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    },
    "original_essential_obligation_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "theme",
          "evidence_ids",
          "status",
          "supporting_insight_ids",
          "explanation"
        ],
        "properties": {
          "theme": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "status": {
            "type": "string",
            "enum": ["covered", "partial", "uncovered"]
          },
          "supporting_insight_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
