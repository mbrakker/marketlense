{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selected_category_ids",
    "category_fits"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "selected_category_ids": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "category_fits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_id",
          "label",
          "fit_score",
          "decision",
          "why_fit",
          "why_not_fit",
          "evidence_sections"
        ],
        "properties": {
          "category_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "fit_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "decision": {
            "type": "string",
            "enum": ["primary", "secondary", "reject"]
          },
          "why_fit": {
            "type": "string"
          },
          "why_not_fit": {
            "type": "string"
          },
          "evidence_sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "semantic_rule_status": {
            "type": "string",
            "enum": ["supported", "rejected", "ambiguous", "not_evaluated"]
          },
          "supported_topic_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supported_topic_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rejected_topic_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rejected_topic_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rule_evidence_sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "centrality_evidence_sections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remediation_signal": {
            "type": "string"
          }
        }
      }
    }
  }
}
