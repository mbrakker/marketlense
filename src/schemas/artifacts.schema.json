{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifacts",
  "type": "object",
  "required": ["toc_topics", "summary", "cover_semantics", "insights_candidates", "insights_final", "quotes_final", "expert_comment", "linkedin_post"],
  "properties": {
    "schema_version": { "type": "string" },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "toc_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "section_title", "display_title", "summary", "key_points", "pages", "order"],
        "properties": {
          "section_id": { "type": "string" },
          "section_title": { "type": "string" },
          "display_title": { "type": "string" },
          "summary": { "type": "string" },
          "key_points": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "order": { "type": "integer" }
        }
      }
    },
    "toc_topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "toc_topics_expanded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "summary", "key_points"],
        "properties": {
          "topic": { "type": "string" },
          "summary": { "type": "string" },
          "key_points": {
            "type": "array",
            "items": { "type": "string" }
          },
          "section_id": { "type": "string" },
          "section_title": { "type": "string" },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "metric_spine": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "metric_id", "label", "value", "unit", "evidence_id"],
        "properties": {
          "schema_version": { "type": "string" },
          "metric_id": { "type": "string" },
          "label": { "type": "string" },
          "value": { "type": "string" },
          "unit": { "type": "string" },
          "timeframe": { "type": "string" },
          "segment": { "type": "string" },
          "geography": { "type": "string" },
          "comparator": { "type": "string" },
          "baseline": { "type": "string" },
          "delta": { "type": "string" },
          "sample_size": { "type": "string" },
          "confidence": { "type": "string" },
          "missing_context_notes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_id": { "type": "string" }
        }
      }
    },
    "topics_covered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "topic_id", "topic", "subtopics", "why_it_matters", "evidence_ids", "pages", "status"],
        "properties": {
          "schema_version": { "type": "string" },
          "topic_id": { "type": "string" },
          "topic": { "type": "string" },
          "subtopics": {
            "type": "array",
            "items": { "type": "string" }
          },
          "why_it_matters": { "type": "string" },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "status": { "type": "string" }
        }
      }
    },
    "key_figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "figure_id", "figure", "label", "unit", "why_it_matters", "evidence_id"],
        "properties": {
          "schema_version": { "type": "string" },
          "figure_id": { "type": "string" },
          "figure": { "type": "string" },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "segment": { "type": "string" },
          "geography": { "type": "string" },
          "timeframe": { "type": "string" },
          "source_page": { "type": ["integer", "null"] },
          "why_it_matters": { "type": "string" },
          "caveat": { "type": "string" },
          "evidence_id": { "type": "string" },
          "related_chart_candidate": { "type": "string" }
        }
      }
    },
    "chart_insight_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "card_id",
          "status",
          "caption",
          "takeaway",
          "business_implication",
          "metric_mentions",
          "evidence_confidence",
          "evidence_id",
          "avoid_reason_if_weak"
        ],
        "properties": {
          "schema_version": { "type": "string" },
          "card_id": { "type": "string" },
          "status": { "type": "string" },
          "caption": { "type": "string" },
          "takeaway": { "type": "string" },
          "business_implication": { "type": "string" },
          "metric_mentions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_confidence": { "type": "string" },
          "evidence_id": { "type": "string" },
          "source_page": { "type": ["integer", "null"] },
          "avoid_reason_if_weak": { "type": "string" }
        }
      }
    },
    "claim_ledgers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "canonical_claim_id",
          "claim_text",
          "artifact_section",
          "evidence_ids",
          "support_type",
          "confidence",
          "risk"
        ],
        "properties": {
          "schema_version": { "type": "string" },
          "canonical_claim_id": { "type": "string" },
          "claim_text": { "type": "string" },
          "artifact_section": { "type": "string" },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "support_type": { "type": "string" },
          "evidence_quality_grade": { "type": "string" },
          "confidence": { "type": "string" },
          "risk": { "type": "string" },
          "evidence_span_count": { "type": "integer" }
        }
      }
    },
    "executive_advisory": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string" },
        "decision_brief": { "type": "object" },
        "recommendations": { "type": "object" },
        "risks": { "type": "object" },
        "coverage_diagnostics": { "type": "object" },
        "audience_variants": { "type": "object" },
        "category_relevance": { "type": "object" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["tldr", "card_tldr_compact", "executive_summary", "claim_evidence_map"],
      "properties": {
        "tldr": { "type": "string" },
        "card_tldr_compact": { "type": "string" },
        "executive_summary": { "type": "string" },
        "claim_evidence_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "evidence_id", "evidence"],
            "properties": {
              "claim": { "type": "string" },
              "evidence_id": { "type": "string" },
              "evidence": { "type": "string" },
              "evidence_spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["evidence_id", "source_pack"],
                  "properties": {
                    "evidence_id": { "type": "string" },
                    "source_pack": { "type": "string" },
                    "section_id": { "type": "string" },
                    "page": { "type": "integer" },
                    "start_offset": { "type": "integer" },
                    "end_offset": { "type": "integer" },
                    "text": { "type": "string" }
                  }
                }
              },
              "pages": {
                "type": "array",
                "items": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "cover_semantics": {
      "type": "object",
      "required": ["evidence_shape", "direction", "geography_scope", "evidence_density", "domain_layer", "selection_reason"],
      "additionalProperties": false,
      "properties": {
        "evidence_shape": { "type": "string", "enum": ["trend", "comparison", "distribution", "flow", "network", "concentration", "hierarchy", "cycle", "uncertainty", "system"] },
        "direction": { "type": "string", "enum": ["rising", "falling", "stable", "volatile", "converging", "diverging", "cyclical", "neutral"] },
        "geography_scope": { "type": "string", "enum": ["global", "regional", "country", "unknown"] },
        "evidence_density": { "type": "string", "enum": ["metric_rich", "balanced", "qualitative"] },
        "domain_layer": { "type": "string", "enum": ["grid", "forecast"] },
        "selection_reason": { "type": "string", "minLength": 1 }
      }
    },
    "insights_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "evidence_id"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "evidence_id": { "type": "string" },
          "evidence": { "type": "string" },
          "evidence_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "source_pack"],
              "properties": {
                "evidence_id": { "type": "string" },
                "source_pack": { "type": "string" },
                "section_id": { "type": "string" },
                "page": { "type": "integer" },
                "start_offset": { "type": "integer" },
                "end_offset": { "type": "integer" },
                "text": { "type": "string" }
              }
            }
          },
          "metric": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "unit": { "type": "string" },
              "trend": { "type": "string" },
              "timeframe": { "type": "string" },
              "geography": { "type": "string" },
              "segment": { "type": "string" },
              "sample_size": { "type": "string" },
              "confidence": { "type": "string" }
            }
          },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "score": { "type": "number" },
          "decision_relevance_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "metric_strength_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "novelty_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "coverage_role": {
            "type": "string",
            "enum": ["market_context", "behavior_shift", "strategic_risk", "operating_implication", "investment_signal", "proof_point", "counter_signal"]
          },
          "so_what": { "type": "string" },
          "now_what": { "type": "string" },
          "report_type_lens": {
            "type": "string",
            "enum": ["market_size", "consumer_behavior", "technology_shift", "channel_strategy", "brand_strategy", "investment_outlook", "risk_regulation", "operations", "creative_culture"]
          }
        }
      }
    },
    "insights_final": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "evidence_id"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "evidence_id": { "type": "string" },
          "evidence": { "type": "string" },
          "evidence_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "source_pack"],
              "properties": {
                "evidence_id": { "type": "string" },
                "source_pack": { "type": "string" },
                "section_id": { "type": "string" },
                "page": { "type": "integer" },
                "start_offset": { "type": "integer" },
                "end_offset": { "type": "integer" },
                "text": { "type": "string" }
              }
            }
          },
          "metric": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "unit": { "type": "string" },
              "trend": { "type": "string" },
              "timeframe": { "type": "string" },
              "geography": { "type": "string" },
              "segment": { "type": "string" },
              "sample_size": { "type": "string" },
              "confidence": { "type": "string" }
            }
          },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "score": { "type": "number" },
          "decision_relevance_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "metric_strength_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "novelty_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "coverage_role": {
            "type": "string",
            "enum": ["market_context", "behavior_shift", "strategic_risk", "operating_implication", "investment_signal", "proof_point", "counter_signal"]
          },
          "so_what": { "type": "string" },
          "now_what": { "type": "string" },
          "report_type_lens": {
            "type": "string",
            "enum": ["market_size", "consumer_behavior", "technology_shift", "channel_strategy", "brand_strategy", "investment_outlook", "risk_regulation", "operations", "creative_culture"]
          }
        }
      }
    },
    "quotes_final": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "evidence_id"],
        "properties": {
          "text": { "type": "string" },
          "speaker": { "type": "string" },
          "citation": { "type": "string" },
          "page": { "type": "integer" },
          "evidence_id": { "type": "string" },
          "is_paraphrase": { "type": "boolean" },
          "style": { "type": "string" },
          "mode": { "type": "string" },
          "label": { "type": "string" },
          "evidence_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "source_pack"],
              "properties": {
                "evidence_id": { "type": "string" },
                "source_pack": { "type": "string" },
                "section_id": { "type": "string" },
                "page": { "type": "integer" },
                "start_offset": { "type": "integer" },
                "end_offset": { "type": "integer" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "expert_comment": { "type": "string" },
    "linkedin_post": { "type": "string" },
    "source_status": {
      "type": "object",
      "required": ["not_available", "reason"],
      "properties": {
        "schema_version": { "type": "string" },
        "text_density": { "type": "number" },
        "density_threshold": { "type": "number" },
        "pages_sampled": { "type": "integer" },
        "char_count": { "type": "integer" },
        "not_available": { "type": "boolean" },
        "reason": { "type": "string" },
        "evidence_present": { "type": "boolean" }
      }
    },
    "family_status": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "schema_version",
          "family",
          "source",
          "status",
          "confidence_score",
          "policy_action",
          "reason"
        ],
        "properties": {
          "schema_version": { "type": "string" },
          "family": { "type": "string" },
          "source": { "type": "string", "enum": ["artifact"] },
          "status": { "type": "string", "enum": ["generated", "abstained"] },
          "confidence_score": { "type": "number" },
          "policy_action": {
            "type": "string",
            "enum": ["keep", "regenerate", "abstain"]
          },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
