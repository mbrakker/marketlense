{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifacts",
  "type": "object",
  "required": ["toc_topics", "summary", "insights_candidates", "insights_final", "quotes_final", "expert_comment", "linkedin_post"],
  "properties": {
    "schema_version": { "type": "string" },
    "toc_topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": {
      "type": "object",
      "required": ["tldr", "executive_summary", "claim_evidence_map"],
      "properties": {
        "tldr": { "type": "string" },
        "executive_summary": { "type": "string" },
        "claim_evidence_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "evidence_id", "evidence"],
            "properties": {
              "claim": { "type": "string" },
              "evidence_id": { "type": "string" },
              "evidence": { "type": "string" },
              "pages": {
                "type": "array",
                "items": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "insights_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "evidence_id"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "evidence_id": { "type": "string" },
          "evidence": { "type": "string" },
          "metric": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "unit": { "type": "string" },
              "trend": { "type": "string" },
              "timeframe": { "type": "string" },
              "geography": { "type": "string" },
              "segment": { "type": "string" },
              "sample_size": { "type": "string" },
              "confidence": { "type": "string" }
            }
          },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "score": { "type": "number" }
        }
      }
    },
    "insights_final": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "evidence_id"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "evidence_id": { "type": "string" },
          "evidence": { "type": "string" },
          "metric": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "unit": { "type": "string" },
              "trend": { "type": "string" },
              "timeframe": { "type": "string" },
              "geography": { "type": "string" },
              "segment": { "type": "string" },
              "sample_size": { "type": "string" },
              "confidence": { "type": "string" }
            }
          },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "quotes_final": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "evidence_id"],
        "properties": {
          "text": { "type": "string" },
          "speaker": { "type": "string" },
          "citation": { "type": "string" },
          "page": { "type": "integer" },
          "evidence_id": { "type": "string" }
        }
      }
    },
    "expert_comment": { "type": "string" },
    "linkedin_post": { "type": "string" },
    "source_status": {
      "type": "object",
      "required": ["not_available", "reason"],
      "properties": {
        "schema_version": { "type": "string" },
        "text_density": { "type": "number" },
        "density_threshold": { "type": "number" },
        "pages_sampled": { "type": "integer" },
        "char_count": { "type": "integer" },
        "not_available": { "type": "boolean" },
        "reason": { "type": "string" },
        "evidence_present": { "type": "boolean" }
      }
    }
  }
}
