{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifacts",
  "type": "object",
  "required": ["toc_topics", "summary", "insights_candidates", "insights_final", "quotes_final", "expert_comment", "linkedin_post"],
  "properties": {
    "schema_version": { "type": "string" },
    "toc_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "section_title", "display_title", "summary", "key_points", "pages", "order"],
        "properties": {
          "section_id": { "type": "string" },
          "section_title": { "type": "string" },
          "display_title": { "type": "string" },
          "summary": { "type": "string" },
          "key_points": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "order": { "type": "integer" }
        }
      }
    },
    "toc_topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "toc_topics_expanded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "summary", "key_points"],
        "properties": {
          "topic": { "type": "string" },
          "summary": { "type": "string" },
          "key_points": {
            "type": "array",
            "items": { "type": "string" }
          },
          "section_id": { "type": "string" },
          "section_title": { "type": "string" },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["tldr", "executive_summary", "claim_evidence_map"],
      "properties": {
        "tldr": { "type": "string" },
        "executive_summary": { "type": "string" },
        "claim_evidence_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "evidence_id", "evidence"],
            "properties": {
              "claim": { "type": "string" },
              "evidence_id": { "type": "string" },
              "evidence": { "type": "string" },
              "evidence_spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["evidence_id", "source_pack"],
                  "properties": {
                    "evidence_id": { "type": "string" },
                    "source_pack": { "type": "string" },
                    "section_id": { "type": "string" },
                    "page": { "type": "integer" },
                    "start_offset": { "type": "integer" },
                    "end_offset": { "type": "integer" },
                    "text": { "type": "string" }
                  }
                }
              },
              "pages": {
                "type": "array",
                "items": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "insights_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "evidence_id"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "evidence_id": { "type": "string" },
          "evidence": { "type": "string" },
          "evidence_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "source_pack"],
              "properties": {
                "evidence_id": { "type": "string" },
                "source_pack": { "type": "string" },
                "section_id": { "type": "string" },
                "page": { "type": "integer" },
                "start_offset": { "type": "integer" },
                "end_offset": { "type": "integer" },
                "text": { "type": "string" }
              }
            }
          },
          "metric": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "unit": { "type": "string" },
              "trend": { "type": "string" },
              "timeframe": { "type": "string" },
              "geography": { "type": "string" },
              "segment": { "type": "string" },
              "sample_size": { "type": "string" },
              "confidence": { "type": "string" }
            }
          },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "score": { "type": "number" }
        }
      }
    },
    "insights_final": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "evidence_id"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "evidence_id": { "type": "string" },
          "evidence": { "type": "string" },
          "evidence_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "source_pack"],
              "properties": {
                "evidence_id": { "type": "string" },
                "source_pack": { "type": "string" },
                "section_id": { "type": "string" },
                "page": { "type": "integer" },
                "start_offset": { "type": "integer" },
                "end_offset": { "type": "integer" },
                "text": { "type": "string" }
              }
            }
          },
          "metric": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "unit": { "type": "string" },
              "trend": { "type": "string" },
              "timeframe": { "type": "string" },
              "geography": { "type": "string" },
              "segment": { "type": "string" },
              "sample_size": { "type": "string" },
              "confidence": { "type": "string" }
            }
          },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "quotes_final": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "evidence_id"],
        "properties": {
          "text": { "type": "string" },
          "speaker": { "type": "string" },
          "citation": { "type": "string" },
          "page": { "type": "integer" },
          "evidence_id": { "type": "string" },
          "is_paraphrase": { "type": "boolean" },
          "style": { "type": "string" },
          "mode": { "type": "string" },
          "label": { "type": "string" },
          "evidence_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "source_pack"],
              "properties": {
                "evidence_id": { "type": "string" },
                "source_pack": { "type": "string" },
                "section_id": { "type": "string" },
                "page": { "type": "integer" },
                "start_offset": { "type": "integer" },
                "end_offset": { "type": "integer" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "expert_comment": { "type": "string" },
    "linkedin_post": { "type": "string" },
    "source_status": {
      "type": "object",
      "required": ["not_available", "reason"],
      "properties": {
        "schema_version": { "type": "string" },
        "text_density": { "type": "number" },
        "density_threshold": { "type": "number" },
        "pages_sampled": { "type": "integer" },
        "char_count": { "type": "integer" },
        "not_available": { "type": "boolean" },
        "reason": { "type": "string" },
        "evidence_present": { "type": "boolean" }
      }
    },
    "family_status": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "schema_version",
          "family",
          "source",
          "status",
          "confidence_score",
          "policy_action",
          "reason"
        ],
        "properties": {
          "schema_version": { "type": "string" },
          "family": { "type": "string" },
          "source": { "type": "string", "enum": ["artifact"] },
          "status": { "type": "string", "enum": ["generated", "abstained"] },
          "confidence_score": { "type": "number" },
          "policy_action": {
            "type": "string",
            "enum": ["keep", "regenerate", "abstain"]
          },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
