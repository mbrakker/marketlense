{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivateRegenerationClaimRepairProposalEnvelope",
  "type": "object",
  "required": ["claim_repair_proposal"],
  "properties": {
    "claim_repair_proposal": {
      "type": "object",
      "required": [
        "schema_version",
        "action",
        "replacement_text",
        "evidence_ids_used"
      ],
      "properties": {
        "schema_version": {"type": "string", "minLength": 1},
        "action": {"enum": ["replace", "remove", "abstain"]},
        "replacement_text": {"type": "string"},
        "evidence_ids_used": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
