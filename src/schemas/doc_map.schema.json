{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocMap",
  "type": "object",
  "required": ["doc_id", "title", "sections"],
  "properties": {
    "schema_version": { "type": "string" },
    "doc_id": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "family_status": {
      "type": "object",
      "required": [
        "schema_version",
        "family",
        "source",
        "status",
        "confidence_score",
        "policy_action",
        "reason"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "family": { "type": "string" },
        "source": { "type": "string", "enum": ["evidence_pack"] },
        "status": { "type": "string", "enum": ["generated", "abstained"] },
        "confidence_score": { "type": "number" },
        "policy_action": {
          "type": "string",
          "enum": ["keep", "regenerate", "abstain"]
        },
        "reason": { "type": "string" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "key_points"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "key_points": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "references": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
