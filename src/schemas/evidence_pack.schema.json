{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidencePack",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": ["string", "null"] },
    "scope": { "type": ["string", "object", "null"] },
    "methods": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "type": "object", "additionalProperties": true }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": ["string", "null"] },
          "text": { "type": ["string", "null"] },
          "evidence": { "type": ["string", "null"] },
          "confidence": { "type": ["string", "null"] },
          "pages": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quote_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "text": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] },
          "page": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
