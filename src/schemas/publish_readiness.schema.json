{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublishReadinessArtifact",
  "type": "object",
  "required": [
    "report_id",
    "status",
    "artifact_hashes",
    "rule_results",
    "final_html_hash",
    "publication_projection_hash",
    "configuration_hash",
    "policy_hash",
    "producer_revision",
    "created_at_utc",
    "expires_at_utc",
    "staleness_conditions",
    "provenance",
    "artifact_hash",
    "validator_version",
    "schema_version"
  ],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["pass", "fail"]},
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "rule_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "status", "surfaces", "detail", "schema_version"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "surfaces": {"type": "array", "items": {"type": "string"}},
          "detail": {"type": "string"},
          "schema_version": {"type": "string", "const": "1.0"}
        },
        "additionalProperties": false
      }
    },
    "final_html_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "publication_projection_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "configuration_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "producer_revision": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "staleness_conditions": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "validator_version": {"type": "string", "const": "publish-readiness:v1"},
    "schema_version": {"type": "string", "const": "1.0"}
  },
  "additionalProperties": false
}
