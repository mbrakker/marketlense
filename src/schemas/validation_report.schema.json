{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ValidationReport",
  "type": "object",
  "required": ["status", "errors", "warnings", "source_artifact"],
  "properties": {
    "schema_version": { "type": "string" },
    "status": { "type": "string", "enum": ["pass", "fail"] },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_artifact": { "type": "string" }
  }
}
