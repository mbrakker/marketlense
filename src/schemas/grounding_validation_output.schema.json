{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["unsupported", "checks"],
  "properties": {
    "unsupported": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "text", "reason"],
        "properties": {
          "section": {"type": "string"},
          "text": {"type": "string"},
          "classification": {"type": "string"},
          "entailment_outcome": {"type": "string", "enum": ["contradicted", "not_established"]},
          "violation_type": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "text", "classification", "entailment_outcome", "proposition_status", "protected_facts", "reason"],
        "properties": {
          "section": {"type": "string"},
          "text": {"type": "string"},
          "classification": {"const": "factual_claim"},
          "entailment_outcome": {"type": "string", "enum": ["entailed", "contradicted", "not_established"]},
          "proposition_status": {"type": "string", "enum": ["compatible", "incompatible", "unknown"]},
          "protected_facts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "unit_currency", "magnitude", "direction", "timeframe", "geography", "population", "comparison", "observation_status", "attribution", "certainty", "causality"],
            "properties": {
              "value": {"$ref": "#/$defs/protected_fact_dimension"},
              "unit_currency": {"$ref": "#/$defs/protected_fact_dimension"},
              "magnitude": {"$ref": "#/$defs/protected_fact_dimension"},
              "direction": {"$ref": "#/$defs/protected_fact_dimension"},
              "timeframe": {"$ref": "#/$defs/protected_fact_dimension"},
              "geography": {"$ref": "#/$defs/protected_fact_dimension"},
              "population": {"$ref": "#/$defs/protected_fact_dimension"},
              "comparison": {"$ref": "#/$defs/protected_fact_dimension"},
              "observation_status": {"$ref": "#/$defs/protected_fact_dimension"},
              "attribution": {"$ref": "#/$defs/protected_fact_dimension"},
              "certainty": {"$ref": "#/$defs/protected_fact_dimension"},
              "causality": {"$ref": "#/$defs/protected_fact_dimension"}
            }
          },
          "reason": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "protected_fact_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_value", "evidence_value", "status"],
      "properties": {
        "claim_value": {"type": ["string", "null"]},
        "evidence_value": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["compatible", "incompatible", "unknown"]}
      }
    }
  }
}
