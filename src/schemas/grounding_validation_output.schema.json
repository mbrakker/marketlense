{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["checks"],
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "classification",
          "entailment_outcome",
          "violation_type",
          "proposition_status",
          "protected_facts",
          "reason"
        ],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "classification": {
            "type": "string",
            "enum": [
              "factual_claim",
              "analyst_interpretation",
              "prescriptive_recommendation"
            ]
          },
          "entailment_outcome": {
            "type": "string",
            "enum": ["entailed", "contradicted", "not_established"]
          },
          "violation_type": {
            "type": "string",
            "minLength": 1,
            "description": "For an entailed verdict use none. For contradicted or not_established, select the most appropriate type: hallucinated_entity_or_event, unsupported_number, misattributed_quote, report_directive_misattribution, unsupported_factual_claim, unsupported_causal_outcome, unsupported_certainty, unsupported_operational_or_financial_benefit, numerically_inconsistent, contradicted, not_established, invalid_comparison, missing_material_evidence, hallucinated_evidence_id, evidence_retrieval_failure, or non_fatal_interpretation. Do not use none for a non-entailed verdict."
          },
          "proposition_status": {
            "type": "string",
            "enum": ["compatible", "incompatible", "unknown"]
          },
          "protected_facts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit_currency",
              "magnitude",
              "direction",
              "timeframe",
              "geography",
              "population",
              "comparison",
              "observation_status",
              "attribution",
              "certainty",
              "causality"
            ],
            "properties": {
              "value": {"$ref": "#/$defs/protected_fact_dimension"},
              "unit_currency": {"$ref": "#/$defs/protected_fact_dimension"},
              "magnitude": {"$ref": "#/$defs/protected_fact_dimension"},
              "direction": {"$ref": "#/$defs/protected_fact_dimension"},
              "timeframe": {"$ref": "#/$defs/protected_fact_dimension"},
              "geography": {"$ref": "#/$defs/protected_fact_dimension"},
              "population": {"$ref": "#/$defs/protected_fact_dimension"},
              "comparison": {"$ref": "#/$defs/protected_fact_dimension"},
              "observation_status": {"$ref": "#/$defs/protected_fact_dimension"},
              "attribution": {"$ref": "#/$defs/protected_fact_dimension"},
              "certainty": {"$ref": "#/$defs/protected_fact_dimension"},
              "causality": {"$ref": "#/$defs/protected_fact_dimension"}
            }
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "protected_fact_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_value", "evidence_value", "status"],
      "properties": {
        "claim_value": {"type": ["string", "null"]},
        "evidence_value": {"type": ["string", "null"]},
        "status": {
          "type": "string",
          "enum": ["compatible", "incompatible", "unknown"]
        }
      }
    }
  }
}
