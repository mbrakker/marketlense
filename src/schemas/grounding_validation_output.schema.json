{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["unsupported"],
  "properties": {
    "unsupported": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "text", "reason"],
        "properties": {
          "section": {"type": "string"},
          "text": {"type": "string"},
          "classification": {"type": "string"},
          "entailment_outcome": {
            "type": "string",
            "enum": ["contradicted", "not_established"]
          },
          "violation_type": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
