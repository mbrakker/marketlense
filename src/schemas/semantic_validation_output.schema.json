{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["metrics", "quotes"],
  "properties": {
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "supported", "confidence", "reason"],
        "properties": {
          "id": {"type": "string"},
          "supported": {"type": ["boolean", "string"]},
          "confidence": {"type": ["number", "string"]},
          "reason": {"type": "string"}
        }
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "supported", "confidence", "reason"],
        "properties": {
          "id": {"type": "string"},
          "supported": {"type": ["boolean", "string"]},
          "confidence": {"type": ["number", "string"]},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
