{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivateRegenerationRepairDecisionEnvelope",
  "type": "object",
  "required": ["repair_decision"],
  "properties": {
    "repair_decision": {
      "type": "object",
      "required": [
        "schema_version",
        "repair_action",
        "repair_strategy",
        "evidence_ids_used",
        "changed_paths",
        "minimal_patch"
      ],
      "properties": {
        "schema_version": {"type": "string"},
        "repair_action": {"type": "string", "minLength": 1},
        "repair_strategy": {"type": "string", "minLength": 1},
        "evidence_ids_used": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "changed_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "minimal_patch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["op", "path", "value_json"],
            "properties": {
              "op": {"type": "string", "const": "replace"},
              "path": {"type": "string", "minLength": 1},
              "value_json": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
