{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivateRegenerationRepairDecisionEnvelope",
  "type": "object",
  "required": ["repair_decision"],
  "properties": {
    "repair_decision": {
      "type": "object",
      "required": [
        "schema_version",
        "diagnosed_failure_class",
        "repair_action",
        "repair_strategy",
        "evidence_ids_used",
        "protected_fields",
        "changed_paths",
        "minimal_patch",
        "claim_provenance"
      ],
      "properties": {
        "schema_version": {"type": "string"},
        "diagnosed_failure_class": {"type": "string", "minLength": 1},
        "repair_action": {"type": "string", "minLength": 1},
        "repair_strategy": {"type": "string", "minLength": 1},
        "evidence_ids_used": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "protected_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "changed_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "minimal_patch": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["op", "path", "value_json"],
            "properties": {
              "op": {"type": "string", "const": "replace"},
              "path": {"type": "string", "minLength": 1},
              "value_json": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "claim_provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "classification", "evidence_ids"],
            "properties": {
              "claim": {"type": "string"},
              "classification": {
                "enum": ["factual", "interpretive", "recommendation"]
              },
              "evidence_ids": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
