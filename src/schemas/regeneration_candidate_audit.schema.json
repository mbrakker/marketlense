{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegenerationCandidateAudit",
  "type": "object",
  "required": [
    "schema_version",
    "attempt_index",
    "transformation_scope",
    "before_sha256",
    "after_sha256",
    "current_artifacts_path",
    "candidate_artifacts_path",
    "validation_status",
    "promotion_outcome",
    "validation_issues",
    "evidence_lineage"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "attempt_index": { "type": "integer", "minimum": 1 },
    "transformation_scope": { "type": "array", "items": { "type": "string" } },
    "unchanged_family_sha256": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 64, "maxLength": 64 }
    },
    "before_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "after_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "current_artifacts_path": { "type": "string" },
    "candidate_artifacts_path": { "type": "string" },
    "validation_status": { "type": "string" },
    "promotion_outcome": { "enum": ["candidate", "promoted", "rolled_back"] },
    "validation_issues": { "type": "array", "items": { "type": "string" } },
    "failure_fingerprints": { "type": "array", "items": { "type": "string", "minLength": 64, "maxLength": 64 } },
    "repair_action": { "type": "string" },
    "repair_strategy": { "type": "string" },
    "strategy_fingerprint": { "type": "string", "maxLength": 160 },
    "report_id": { "type": "string", "maxLength": 160 },
    "validation_run_id": { "type": "string", "maxLength": 160 },
    "cohort_id": { "type": "string", "maxLength": 160 },
    "workflow_run_id": { "type": "string", "maxLength": 160 },
    "configuration_hash": { "type": "string", "maxLength": 160 },
    "policy_hash": { "type": "string", "maxLength": 160 },
    "producer_build_identity": { "type": "string", "maxLength": 160 },
    "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "verified_dependent_paths": { "type": "array", "items": { "type": "string" } },
    "selected_evidence_ids": { "type": "array", "items": { "type": "string" } },
    "quarantined_evidence_ids": { "type": "array", "items": { "type": "string" } },
    "repair_delta": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string" },
        "resolved": { "type": "array" },
        "persisting": { "type": "array" },
        "introduced": { "type": "array" },
        "introduced_hard_failure_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "severity_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["failure_fingerprint", "before", "after"],
            "properties": {
              "failure_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
              "before": { "enum": ["error", "warning", "info"] },
              "after": { "enum": ["error", "warning", "info"] }
            },
            "additionalProperties": false
          }
        },
        "mutation_scope_result": { "enum": ["pass", "fail", "not_evaluated"] },
        "evidence_lineage_result": { "enum": ["pass", "fail", "not_evaluated"] },
        "repair_action": { "type": "string" },
        "repair_strategy": { "type": "string" },
        "evidence_ids_used": { "type": "array", "items": { "type": "string" } },
        "strategy_fingerprint": { "type": "string", "maxLength": 160 },
        "candidate_sha256": { "type": "string", "maxLength": 64 },
        "input_sha256": { "type": "string", "maxLength": 64 },
        "validator_identity": { "type": "string", "maxLength": 160 }
      },
      "additionalProperties": false
    },
    "repair_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "diagnosed_failure_class",
          "repair_action",
          "repair_strategy",
          "evidence_ids_used",
          "protected_fields",
          "changed_paths",
          "minimal_patch",
          "claim_provenance"
        ],
        "properties": {
          "schema_version": { "type": "string" },
          "diagnosed_failure_class": { "type": "string", "minLength": 1 },
          "repair_action": { "type": "string", "minLength": 1 },
          "repair_strategy": { "type": "string", "minLength": 1 },
          "evidence_ids_used": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "protected_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "changed_paths": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "minimal_patch": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["op", "path", "value"],
              "properties": {
                "op": { "const": "replace" },
                "path": { "type": "string", "minLength": 1 },
                "value": { "type": ["string", "number", "boolean", "object", "array", "null"] }
              },
              "additionalProperties": false
            }
          },
          "claim_provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim", "classification", "evidence_ids"],
              "properties": {
                "claim": { "type": "string" },
                "classification": { "enum": ["factual", "interpretive", "recommendation"] },
                "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "entity_kind",
          "entity_id",
          "original_evidence_ids",
          "candidate_evidence_ids",
          "original_source_pages",
          "candidate_source_pages",
          "validation_issues"
        ],
        "properties": {
          "schema_version": { "type": "string" },
          "entity_kind": { "type": "string" },
          "entity_id": { "type": "string" },
          "original_evidence_ids": { "type": "array", "items": { "type": "string" } },
          "candidate_evidence_ids": { "type": "array", "items": { "type": "string" } },
          "original_source_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "candidate_source_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "validation_issues": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
