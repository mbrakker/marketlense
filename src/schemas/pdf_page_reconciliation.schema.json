{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PdfPageReconciliationResponse",
  "type": "object",
  "required": [
    "schema_version",
    "algorithm_version",
    "input_pdf_md5",
    "physical_page_count",
    "mappings",
    "coverage_statistics"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "algorithm_version": {
      "type": "string",
      "const": "pdf-page-reconciliation-v1"
    },
    "input_pdf_md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "physical_page_count": {"type": "integer", "minimum": 1},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "physical_page",
          "printed_label",
          "status",
          "method",
          "native_pdf_label",
          "evidence"
        ],
        "properties": {
          "physical_page": {"type": "integer", "minimum": 1},
          "printed_label": {"type": ["string", "null"], "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["verified", "inferred", "unresolved"]
          },
          "method": {
            "type": "string",
            "enum": [
              "visible_header",
              "visible_footer",
              "sequence_inference",
              "unresolved"
            ]
          },
          "native_pdf_label": {"type": ["string", "null"], "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["kind", "detail", "anchor_physical_pages"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "visible_header",
                    "visible_footer",
                    "native_pdf_metadata",
                    "sequence_inference",
                    "conflict",
                    "unreadable",
                    "no_visible_label"
                  ]
                },
                "detail": {"type": "string", "minLength": 1, "maxLength": 240},
                "anchor_physical_pages": {
                  "type": "array",
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": {"type": "integer", "minimum": 1}
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "coverage_statistics": {
      "type": "object",
      "required": [
        "verified_count",
        "inferred_count",
        "unresolved_count",
        "verified_percentage",
        "inferred_percentage",
        "unresolved_percentage"
      ],
      "properties": {
        "verified_count": {"type": "integer", "minimum": 0},
        "inferred_count": {"type": "integer", "minimum": 0},
        "unresolved_count": {"type": "integer", "minimum": 0},
        "verified_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "inferred_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "unresolved_percentage": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
