# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyc
*$py.class

# Virtual environments
venv/
ENV/
.venv/

# Distribution / packaging
build/
dist/
*.egg
*.egg-info/
pip-wheel-metadata/

# Unit test / coverage
.pytest_cache/
.coverage
coverage.xml

# Ignore local test fixtures (large PDFs, generated data)
tests/fixtures/*
!tests/fixtures/low_text_status.json
htmlcov/

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace

# System files
.DS_Store
Thumbs.db

# Environment variables / secrets
.env
.env.*

# Application output, caches and runtime state
out/
cache/
debug/
state/
tools/*
!tools/browser-use/
!tools/browser-use/**
!tools/browser-use-upstream.txt
tools/browser-use/.git/
tools/browser-use/.venv/
tools/browser-use/.pytest_cache/
tools/browser-use/.mypy_cache/
tools/browser-use/.ruff_cache/
tools/browser-use/build/
tools/browser-use/dist/
tools/browser-use/*.egg-info/
tools/browser-use/**/__pycache__/
agent-skills/
*.sqlite
*.db

# PyInstaller
*.manifest
*.spec

# Jupyter
.ipynb_checkpoints

# Logs & temporary files
*.log
*.bak
*.tmp

# MyPy
.mypy_cache/

# Local artifacts
sa.json
