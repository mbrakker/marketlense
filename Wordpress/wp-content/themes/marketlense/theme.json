{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "84rem"
    },
    "custom": {
      "radius": {
        "soft": "0.45rem",
        "card": "0.8rem",
        "pill": "999px"
      },
      "shadow": {
        "premium": "0 18px 40px rgba(10, 28, 46, 0.08)",
        "glass": "0 18px 44px rgba(10, 28, 46, 0.09)",
        "card": "0 14px 30px rgba(10, 28, 46, 0.07)",
        "float": "0 22px 48px rgba(7, 22, 38, 0.11)"
      },
      "blur": {
        "glass": "blur(18px)",
        "header": "blur(14px)"
      }
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "text-primary",
          "name": "Text Primary",
          "color": "#162235"
        },
        {
          "slug": "text-secondary",
          "name": "Text Secondary",
          "color": "#51657b"
        },
        {
          "slug": "text-muted",
          "name": "Text Muted",
          "color": "#7a8ba0"
        },
        {
          "slug": "brand-navy",
          "name": "Brand Navy",
          "color": "#10243e"
        },
        {
          "slug": "signal-blue",
          "name": "Signal Blue",
          "color": "#2b6fe8"
        },
        {
          "slug": "support-blue",
          "name": "Support Blue",
          "color": "#90b6dc"
        },
        {
          "slug": "surface-white",
          "name": "Surface White",
          "color": "#ffffff"
        },
        {
          "slug": "background-cool",
          "name": "Background Cool",
          "color": "#f4f7fb"
        },
        {
          "slug": "canvas",
          "name": "Canvas",
          "color": "#f4f7fb"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#ffffff"
        },
        {
          "slug": "surface-muted",
          "name": "Surface Muted",
          "color": "#edf3f8"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#162235"
        },
        {
          "slug": "ink-soft",
          "name": "Ink Soft",
          "color": "#51657b"
        },
        {
          "slug": "midnight",
          "name": "Midnight",
          "color": "#10243e"
        },
        {
          "slug": "teal",
          "name": "Teal",
          "color": "#2b6fe8"
        },
        {
          "slug": "brass",
          "name": "Brass",
          "color": "#90b6dc"
        },
        {
          "slug": "amber",
          "name": "Amber",
          "color": "#bad1eb"
        },
        {
          "slug": "border-subtle",
          "name": "Border Subtle",
          "color": "#d8e2ec"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#d8e2ec"
        },
        {
          "slug": "line",
          "name": "Line",
          "color": "#e8eef5"
        }
      ],
      "gradients": [
        {
          "slug": "hero-paper",
          "name": "Hero Paper",
          "gradient": "linear-gradient(180deg, #ffffff 0%, #f4f7fb 100%)"
        },
        {
          "slug": "quiet-panel",
          "name": "Quiet Panel",
          "gradient": "linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(237,243,248,0.94) 100%)"
        },
        {
          "slug": "hero-sky",
          "name": "Hero Sky",
          "gradient": "linear-gradient(180deg, rgba(250,252,255,0.98) 0%, rgba(232,240,248,0.96) 100%)"
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "vw", "%"],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "2XS",
          "size": "0.375rem"
        },
        {
          "slug": "30",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "S",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "M",
          "size": "1.5rem"
        },
        {
          "slug": "60",
          "name": "L",
          "size": "2.5rem"
        },
        {
          "slug": "70",
          "name": "XL",
          "size": "4rem"
        },
        {
          "slug": "80",
          "name": "2XL",
          "size": "6rem"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Inter\", \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif",
          "name": "Inter",
          "slug": "sans"
        },
        {
          "fontFamily": "\"Fraunces\", \"Iowan Old Style\", \"Palatino Linotype\", serif",
          "name": "Fraunces",
          "slug": "serif"
        },
        {
          "fontFamily": "\"IBM Plex Mono\", \"JetBrains Mono\", monospace",
          "name": "Mono",
          "slug": "mono"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "0.8125rem"
        },
        {
          "slug": "sm",
          "name": "S",
          "size": "0.9375rem"
        },
        {
          "slug": "md",
          "name": "M",
          "size": "1rem"
        },
        {
          "slug": "lg",
          "name": "L",
          "size": "1.1875rem"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "1.75rem"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "2.25rem"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "3.25rem"
        },
        {
          "slug": "4xl",
          "name": "4XL",
          "size": "4.5rem"
        }
      ],
      "lineHeight": true,
      "letterSpacing": true
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "500",
          "lineHeight": "1.2",
          "letterSpacing": "0.01em"
        }
      },
      "core/button": {
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "600",
          "lineHeight": "1",
          "letterSpacing": "0.01em"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "650",
          "lineHeight": "1.02",
          "letterSpacing": "-0.03em"
        }
      },
      "core/post-content": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--50)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--md)",
          "lineHeight": "1.65"
        }
      },
      "core/query": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--60)"
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background-cool)",
      "text": "var(--wp--preset--color--text-secondary)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--signal-blue)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--brand-navy)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--brand-navy)",
          "text": "var(--wp--preset--color--surface-white)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "0.875rem",
          "fontWeight": "600",
          "lineHeight": "1",
          "letterSpacing": "0.01em"
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--text-primary)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "620",
          "lineHeight": "1.1",
          "letterSpacing": "-0.02em"
        }
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--50)"
    },
    "blocks": {
      "core/group": {
        "spacing": {
          "padding": {
            "top": "0",
            "bottom": "0",
            "left": "0",
            "right": "0"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--support-blue)",
            "width": "3px"
          }
        },
        "color": {
          "background": "var(--wp--preset--color--surface-muted)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "nav",
      "title": "Navigation",
      "area": "header"
    },
    {
      "name": "single-content",
      "title": "Single Content",
      "area": "uncategorized"
    }
  ]
}
