{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "100%",
      "wideSize": "100%"
    },
    "custom": {
      "radius": {
        "soft": "0.45rem",
        "card": "0.8rem",
        "pill": "999px"
      },
      "shadow": {
        "card": "0 14px 28px rgba(17, 27, 40, 0.06)",
        "float": "0 18px 40px rgba(10, 17, 28, 0.08)"
      },
      "blur": {
        "header": "blur(14px)"
      }
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "canvas",
          "name": "Canvas",
          "color": "#f3f0ea"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#fffdf9"
        },
        {
          "slug": "surface-muted",
          "name": "Surface Muted",
          "color": "#f7f3ec"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#111b28"
        },
        {
          "slug": "ink-soft",
          "name": "Ink Soft",
          "color": "#53606e"
        },
        {
          "slug": "midnight",
          "name": "Midnight",
          "color": "#14212d"
        },
        {
          "slug": "teal",
          "name": "Teal",
          "color": "#0f6b63"
        },
        {
          "slug": "brass",
          "name": "Brass",
          "color": "#9d7b41"
        },
        {
          "slug": "border",
          "name": "Border",
          "color": "#d8cec0"
        }
      ],
      "gradients": [
        {
          "slug": "hero-paper",
          "name": "Hero Paper",
          "gradient": "linear-gradient(180deg, #fffdf9 0%, #f7f2e9 100%)"
        },
        {
          "slug": "quiet-panel",
          "name": "Quiet Panel",
          "gradient": "linear-gradient(180deg, rgba(255,253,249,0.98) 0%, rgba(247,243,236,0.92) 100%)"
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "vw", "%"],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "2XS",
          "size": "0.375rem"
        },
        {
          "slug": "30",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "S",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "M",
          "size": "1.5rem"
        },
        {
          "slug": "60",
          "name": "L",
          "size": "2.5rem"
        },
        {
          "slug": "70",
          "name": "XL",
          "size": "4rem"
        },
        {
          "slug": "80",
          "name": "2XL",
          "size": "6rem"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Manrope\", \"Avenir Next\", \"Segoe UI\", sans-serif",
          "name": "Manrope",
          "slug": "sans"
        },
        {
          "fontFamily": "\"Fraunces\", \"Iowan Old Style\", \"Palatino Linotype\", serif",
          "name": "Fraunces",
          "slug": "serif"
        },
        {
          "fontFamily": "\"IBM Plex Mono\", \"JetBrains Mono\", monospace",
          "name": "Mono",
          "slug": "mono"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "0.8rem"
        },
        {
          "slug": "sm",
          "name": "S",
          "size": "0.95rem"
        },
        {
          "slug": "md",
          "name": "M",
          "size": "1.05rem"
        },
        {
          "slug": "lg",
          "name": "L",
          "size": "1.25rem"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "1.65rem"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "2.35rem"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "3.3rem"
        },
        {
          "slug": "4xl",
          "name": "4XL",
          "size": "4.6rem"
        }
      ],
      "lineHeight": true,
      "letterSpacing": true
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontSize": "0.92rem",
          "fontWeight": "600"
        }
      },
      "core/button": {
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontSize": "0.9rem",
          "fontWeight": "600",
          "letterSpacing": "0.01em"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)"
        }
      },
      "core/post-content": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--50)"
        }
      },
      "core/query": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--60)"
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--teal)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--midnight)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--midnight)",
          "text": "var(--wp--preset--color--surface)"
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--midnight)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "600",
          "lineHeight": "1.08",
          "letterSpacing": "-0.02em"
        }
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "lineHeight": "1.72"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--50)"
    },
    "blocks": {
      "core/group": {
        "spacing": {
          "padding": {
            "top": "0",
            "bottom": "0",
            "left": "0",
            "right": "0"
          }
        }
      },
      "core/pullquote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--brass)",
            "width": "3px"
          }
        },
        "color": {
          "background": "var(--wp--preset--color--surface-muted)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "nav",
      "title": "Navigation",
      "area": "header"
    },
    {
      "name": "single-content",
      "title": "Single Content",
      "area": "uncategorized"
    }
  ]
}
