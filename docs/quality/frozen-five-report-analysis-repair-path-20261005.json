  "optimization": {
    "priority": "P0 repair-path correctness followed by P1 exact-evidence semantic batching",
    "p0_repair_path": {
      "priority": "P0 repair-path reliability",
      "root_cause": "When deterministic summary-copy removal retired a uniquely bound summary.claim_evidence_map row, the generator reported only the broad map root. Orchestrator scope verification authorized only paths directly listed in the repair plan, so the exact derived row deletion could be treated as undeclared and a safe candidate rolled back.",
      "change": "The generator now reports each retired map row by exact stable item ID or index. The orchestrator admits that derived path only after before/after artifact diff, planned summary sentence removal, issue claim ID, provenance, evidence binding uniqueness, and absence from the resulting public summary all agree. Candidate validation still rejects reintroduced claims and ambiguous bindings fail closed.",
      "live_cohort_exercised_summary_copy_removal": false,
      "live_scope_note": "Adjust had no targeted repair in this run. The specific derived-row path is covered by focused deterministic tests; the live cohort does not establish that this fix reduces repair latency."
    },
    "p1_change": "Evidence-fidelity semantic fallback claims are grouped only when ordered evidence IDs and source text match; results map to unique claim IDs, while malformed or incomplete outputs fail closed.",
    "live_evidence": "The P1 KPMG run batched three claims sharing source:page:2 into one call and checked one page-5 claim in a second: four candidates in two calls rather than four independent calls for these inputs.",
    "p0_specific_derived_claim_map_removal_exercised_live": false,
    "p0_live_scope_note": "The Reuters repair changed one executive-summary sentence and kept summary.claim_evidence_map paths protected. Exact derived-row deletion was verified by deterministic regression tests, not exercised live."
  },
