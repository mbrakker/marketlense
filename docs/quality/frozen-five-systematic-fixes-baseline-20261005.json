  "root_cause_findings": [
    {
      "fix": "Use warning issues as claim targets only when that target has no blocking errors; keep mixed targets restricted to errors.",
      "fix_commit": "de0a0d57116758df338066cd6f0fe8eaf67f0fc2",
      "regression_test": "test_warning_only_soft_copy_target_runs_with_a_sibling_blocking_repair",
      "root_cause": "The planner created a warning-only soft-copy target when a sibling target had a blocking issue, but the Expert View and LinkedIn handlers discarded all warning issues before claim-scope resolution.",
      "symptom": "Activate repair failed with repair_scope_partition_invalid in the diagnostic run at 894341e16a1b013aeed3273261dcba95099f93f8."
    },
    {
      "fix": "Build plans from promoted artifacts and their current validation report; keep rejected candidate memory for regeneration context and rejected-strategy tracking.",
      "fix_commit": "de0a0d57116758df338066cd6f0fe8eaf67f0fc2",
      "regression_test": "test_rolled_back_summary_candidate_advances_to_bounded_safe_removal",
      "root_cause": "RepairDelta memory from the rolled-back candidate was fed into the next planner decision, so candidate-only resolved/introduced fingerprints overrode the restored promoted artifacts and validation report.",
      "symptom": "Adjust had promoted retained-claim failures but the bounded planner skipped safe removal after a rejected candidate."
    },
    {
      "fix": "Resolve validation and retained-claim pack paths through the canonical pack_path service.",
      "fix_commit": "0ec3cdff841e16df7044f6645fe8379a464f41ca",
      "focused_confirmation": {
        "both_readiness_pass": true,
        "both_retained_claim_counts": [
          0,
          0
        ],
        "both_validation_pass": true,
        "members": 2
      },
      "regression_tests": [
        "test_frozen_member_validation_uses_its_own_artifact_not_a_sibling_report",
        "test_retained_claim_counts_require_the_exact_report_and_source_identity"
      ],
      "root_cause": "Windows path-length compaction in the canonical report-analysis pack service changed the artifact directory slug, while the benchmark reader reconstructed the unbounded slug.",
      "symptom": "Activate was marked validation-fail with null retained-claim counts in the focused run despite passing persisted validation and readiness artifacts."
    },
    {
      "measured_drivers": "The report-analysis maximum was 981.107s; 6 automatic targeted repairs occurred (3 Capgemini and 3 Reuters), including a rolled-back Reuters current-evidence candidate that introduced two hard grounding failures before alternative-evidence repair passed. Provider request and prompt-family timing are unavailable, so LLM service latency cannot be separated from output length and repair work.",
      "queue_wait_context": "Publication-readiness aggregate queue wait was 374s while its maximum execution was 0.915s; this wait was overlapped with the longer report-analysis tail and did not add 374s to cohort wall time.",
      "symptom": "The latest passing run used more time than the previous passing cap-3 run."
    }
