    "publication_safeguard": "The runner persists wordpress_publish.enabled=false after isolated queue bootstrap.",
    "command_text": "@'\nfrom pathlib import Path\nimport hashlib, json, subprocess\nfrom scripts.quality.run_frozen_reliability_cohort import _load_members\nfrom scripts.quality.ias_live_canary_runner import run_frozen_cohort_once\nmanifest=Path('docs/quality/reliability-cohort-20261001-next-five/frozen_cohort.json')\nhead=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()\nstatus=subprocess.check_output(['git','status','--porcelain'],text=True).strip()\nif status: raise RuntimeError(f'Working tree not clean before baseline: {status}')\nsources=_load_members(manifest)\nif len(sources)!=5: raise RuntimeError(f'Expected exactly 5 frozen sources, got {len(sources)}')\nruns_root=Path('tmp/performance-baseline-next-five-queue5-20261004-run1')\nruns_root.mkdir(parents=True,exist_ok=True)\nresult=run_frozen_cohort_once(runs_root=runs_root,sources=sources,max_duration_seconds=7200)\npath=runs_root/'cohort_result.json'\npath.write_text(json.dumps(result,sort_keys=True,separators=(',',':')),encoding='utf-8')\nprint(json.dumps({'head':head,'manifest_sha256':hashlib.sha256(manifest.read_bytes()).hexdigest(),'source_ids':[s['content_md5'] for s in sources],'run_directory':result['run_directory'],'publication_enabled':False,'result_path':str(path)},sort_keys=True))\n'@ | python -",
